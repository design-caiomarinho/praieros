{
  "name": "praieros",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures:save": "node scripts/save-fixtures.ts",
    "bulletins:build": "node scripts/build-bulletins.ts",
    "bulletins:ingest": "node scripts/ingest-bulletins.ts",
    "catalog:validate": "node scripts/catalog.ts validate",
    "catalog:todo": "node scripts/catalog.ts todo",
    "catalog:propose": "node --env-file-if-exists=.env scripts/propose-catalog.ts",
    "tokens:build": "node scripts/build-tokens.ts",
    "catalog:place": "node --env-file-if-exists=.env scripts/place-catalog.ts",
    "catalog:neighborhoods": "node --env-file-if-exists=.env scripts/fill-neighborhoods.ts",
    "catalog:reference": "node --env-file-if-exists=.env scripts/propose-reference.ts"
  },
  "dependencies": {
    "astro": "^7.4.11",
    "cheerio": "^1.2.0",
    "maplibre-gl": "^6.18.0",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.10.0",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
