{
  // Publicação no Cloudflare (Workers Builds: `npx wrangler deploy`). Só arquivos estáticos:
  // a pasta dist é servida como está, com os cabeçalhos de public/_headers.
  "name": "praieros",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    // Endereço que não existe: serve dist/404.html com status 404.
    "not_found_handling": "404-page",
  },
}
