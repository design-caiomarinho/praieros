---
import Icon from './icon.astro';
import type { IconName } from './icon.astro';

interface Props {
  /** Nome acessível (aria-label do ícone): obrigatório, o botão não tem texto. */
  label: string;
  icon?: IconName;
  /** Ícone que toma o lugar do principal enquanto o botão tem `data-swapped` (ex.: copiar → check). */
  swapIcon?: IconName;
  variant?: 'filled' | 'outlined' | 'ghost';
  size?: 'medium' | 'xsmall';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  /** Botão que abre um painel: id do painel (aria-controls, com aria-expanded). */
  controls?: string;
  /** Texto revelado ao lado do ícone no hover e no foco do teclado (Figma 214:2880, ex.: "Busca").
   *  Só visual (aria-hidden): o nome acessível continua em `label`. */
  reveal?: string;
  /** Texto do botão enquanto está "ligado" (painel aberto, `data-engaged`), no desktop: fica
   *  visível, em cor de desabilitado (Figma 213:3706, "Buscar"). */
  revealEngaged?: string;
  /** Só para a vitrine (/dev/components): força o visual de hover/foco. */
  state?: 'hover' | 'focus';
}

const {
  label,
  icon = 'info',
  swapIcon,
  variant = 'filled',
  size = 'medium',
  href,
  type = 'button',
  disabled = false,
  controls,
  reveal,
  revealEngaged,
  state,
} = Astro.props;

const asLink = href !== undefined && !disabled;
const Tag = asLink ? 'a' : 'button';
const attrs = asLink
  ? { href }
  : {
      type,
      disabled,
      'aria-controls': controls,
      'aria-expanded': controls ? ('false' as const) : undefined,
    };
---

<Tag
  class={`btn-icon btn-icon--${variant} btn-icon--${size}`}
  data-reveal={reveal ? '' : undefined}
  data-state={state}
  {...attrs}
>
  {swapIcon ? (
    <span class="btn-icon__glyphs">
      <span class="btn-icon__glyph">
        <Icon name={icon} size={20} label={label} />
      </span>
      <span class="btn-icon__glyph btn-icon__glyph--swap" aria-hidden="true">
        <Icon name={swapIcon} size={20} />
      </span>
    </span>
  ) : (
    <Icon name={icon} size={20} label={label} />
  )}
  {reveal && (
    <span class="btn-icon__reveal" aria-hidden="true">
      <span class="btn-icon__reveal-clip">
        <span
          class="btn-icon__reveal-text"
          data-text={reveal}
          data-text-engaged={revealEngaged ?? reveal}
        />
      </span>
    </span>
  )}
</Tag>

<style>
  /* Dois ícones empilhados: o principal segue na árvore de acessibilidade (nome do botão) e só
     some visualmente enquanto o outro aparece. */
  .btn-icon__glyphs {
    display: grid;
  }
  .btn-icon__glyph {
    grid-area: 1 / 1;
    display: flex;
  }
  .btn-icon__glyph--swap {
    opacity: 0;
  }
  .btn-icon[data-swapped] .btn-icon__glyph:not(.btn-icon__glyph--swap) {
    opacity: 0;
  }
  .btn-icon[data-swapped] .btn-icon__glyph--swap {
    opacity: 1;
  }
  .btn-icon {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: var(--border-width-default) solid transparent;
    background: transparent;
    cursor: pointer;
    text-decoration: none;
    /* Troca de estado (hover, foco, painel aberto) suave; tempo e curva do Figma via Caio. */
    transition:
      background-color var(--motion-duration-hover) var(--motion-easing-hover),
      border-color var(--motion-duration-hover) var(--motion-easing-hover),
      color var(--motion-duration-hover) var(--motion-easing-hover);
  }
  /* Painel abrindo/fechando: o botão se dissolve devagar, sem pressa (pedido de Caio). Vale ao
     ligar e ao desligar `data-engaged` (o botão de busca e o de busca/Fonte que abrem painel). */
  .btn-icon[data-reveal],
  .btn-icon[aria-controls],
  .btn-icon[data-engaged] {
    transition:
      background-color var(--motion-duration-engage)
        var(--motion-easing-dissolve),
      border-color var(--motion-duration-engage) var(--motion-easing-dissolve),
      color var(--motion-duration-engage) var(--motion-easing-dissolve);
  }
  @media (prefers-reduced-motion: reduce) {
    .btn-icon,
    .btn-icon[data-reveal],
    .btn-icon[aria-controls],
    .btn-icon[data-engaged] {
      transition: none;
    }
  }
  /* Figma (Button only-icon, 123:2668): 48 e 40, ícone de 20 centrado; 2 x inset + 24, sem token. */
  .btn-icon--medium {
    padding: 0;
    width: var(--size-control-md);
    height: var(--size-control-md);
  }
  .btn-icon--xsmall {
    padding: 0;
    width: var(--size-control-sm);
    height: var(--size-control-sm);
  }

  /* Revelar o texto (Figma 214:2880): a largura cresce da esquerda do botão (ancorado à direita
     no cabeçalho) de 48 px até a do conteúdo. A coluna do texto vai de 0fr a 1fr (sem medir
     nada em JS); o texto desliza da direita para a esquerda (sem opacidade). Larguras e
     tempos reaproveitam os tokens do pin (500 ms, curva pin-hover). */
  .btn-icon[data-reveal] {
    /* O texto só aparece dentro do botão: o que passa da borda (a entrada vem da direita) é cortado
       e nunca cobre os botões vizinhos. O contorno de foco fica fora (não é cortado). */
    overflow: clip;
    width: auto;
    min-width: var(--size-control-md);
    /* 48 fechado = borda + padding + ícone de 20: o padding lateral é o que sobra. */
    padding-inline: calc(
      (
          var(--space-inset-sm) * 2 + var(--primitives-spacing-24) -
            var(--primitives-spacing-20)
        ) /
        2 - var(--border-width-default)
    );
  }
  .btn-icon__reveal {
    display: grid;
    grid-template-columns: 0fr;
    transition: grid-template-columns var(--motion-duration-pin-hover)
      var(--motion-easing-pin-hover);
  }
  /* O recorte é do botão (overflow: clip lá em cima). `min-width: 0` deixa a coluna ir a 0fr mesmo
     com o texto maior. */
  .btn-icon__reveal-clip {
    min-width: 0;
  }
  /* Padrão do texto revelado: sem opacidade, só deslize. Em repouso o texto fica deslocado por
     toda a sua largura, à direita, fora do botão (recortado por ele); ao revelar, desliza da direita
     para a esquerda até o lugar, com o tempo e a curva da largura, e ao esconder faz o caminho
     inverso. Nunca aparece fora do botão nem cobre os vizinhos. */
  .btn-icon__reveal-text {
    display: block;
    /* Largura do conteúdo (a coluna está em 0fr): o 100% do deslocamento conta a largura do texto. */
    width: max-content;
    padding-left: var(--space-gap-xs);
    white-space: nowrap;
    translate: 100% 0;
    font-family: var(--typo-label-medium-family);
    font-weight: var(--typo-label-medium-weight);
    font-size: var(--typo-label-medium-size);
    line-height: var(--typo-label-medium-line);
    letter-spacing: var(--typo-label-medium-spacing);
    transition: translate var(--motion-duration-pin-hover)
      var(--motion-easing-pin-hover);
  }
  .btn-icon__reveal-text::before {
    content: attr(data-text);
  }
  /* Painel aberto (desktop): o botão fica desabilitado com o texto visível (Figma 213:3706). Mesma
     largura e tempos do hover; no mobile fica só o ícone. */
  @media (min-width: 1024px) {
    .btn-icon[data-reveal][data-engaged] .btn-icon__reveal {
      grid-template-columns: 1fr;
    }
    .btn-icon[data-reveal][data-engaged] .btn-icon__reveal-text {
      translate: 0 0;
    }
    .btn-icon[data-reveal][data-engaged] .btn-icon__reveal-text::before {
      content: attr(data-text-engaged);
    }
  }
  /* Revela no hover (só com mouse) e no foco do teclado; não com o painel aberto nem desabilitado. */
  @media (hover: hover) {
    .btn-icon[data-reveal]:hover:not(:disabled):not([data-engaged])
      .btn-icon__reveal {
      grid-template-columns: 1fr;
    }
    .btn-icon[data-reveal]:hover:not(:disabled):not([data-engaged])
      .btn-icon__reveal-text {
      translate: 0 0;
    }
  }
  .btn-icon[data-reveal]:focus-visible:not([data-engaged]) .btn-icon__reveal,
  .btn-icon[data-reveal][data-state]:not([data-engaged]) .btn-icon__reveal {
    grid-template-columns: 1fr;
  }
  .btn-icon[data-reveal]:focus-visible:not([data-engaged])
    .btn-icon__reveal-text,
  .btn-icon[data-reveal][data-state]:not([data-engaged])
    .btn-icon__reveal-text {
    translate: 0 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .btn-icon__reveal,
    .btn-icon__reveal-text {
      transition: none;
    }
  }

  .btn-icon:focus-visible,
  .btn-icon[data-state='focus'] {
    outline: var(--border-width-default) solid var(--color-border-focus);
    outline-offset: calc(
      var(--primitives-spacing-4) - var(--border-width-default)
    );
  }

  .btn-icon--filled {
    background: var(--color-surface-accent-default);
    color: var(--color-content-on-accent);
  }
  .btn-icon--filled:hover:not(:disabled),
  .btn-icon--filled[data-state='hover'],
  .btn-icon--filled:focus-visible,
  .btn-icon--filled[data-state='focus'] {
    background: var(--color-surface-accent-hover);
  }

  .btn-icon--outlined,
  .btn-icon--ghost {
    background: var(--color-surface-default);
    color: var(--color-content-primary);
  }
  .btn-icon--outlined {
    border-color: var(--color-border-default);
  }
  .btn-icon--outlined:hover:not(:disabled),
  .btn-icon--outlined[data-state='hover'],
  .btn-icon--outlined:focus-visible,
  .btn-icon--outlined[data-state='focus'],
  .btn-icon--ghost:hover:not(:disabled),
  .btn-icon--ghost[data-state='hover'],
  .btn-icon--ghost:focus-visible,
  .btn-icon--ghost[data-state='focus'] {
    background: var(--color-surface-hover);
  }

  /* Botão que abre um painel, com o painel em cena: aparência de desabilitado (Figma 126:4529;
     pedido de Caio): superfície padrão e ícone na cor desabilitada, sem hover. O fechamento
     é pelo botão de fechar do painel. `data-engaged` é ligado pelo painel no tempo da animação
     (a 50% da entrada; só depois da saída completa), enquanto `aria-expanded` muda na hora. */
  .btn-icon--filled[data-engaged] {
    background: var(--color-surface-default);
    color: var(--color-content-disabled);
    cursor: default;
  }
  .btn-icon--ghost[data-engaged] {
    color: var(--color-content-disabled);
    cursor: default;
  }
  .btn-icon--ghost[data-engaged]:hover,
  .btn-icon--ghost[data-engaged]:focus-visible {
    background: var(--color-surface-default);
  }
  .btn-icon--filled[data-engaged]:hover,
  .btn-icon--filled[data-engaged]:focus-visible {
    background: var(--color-surface-default);
  }

  .btn-icon:disabled {
    cursor: not-allowed;
    color: var(--color-content-disabled);
  }
  .btn-icon--filled:disabled {
    background: var(--color-surface-disabled);
  }
  .btn-icon--outlined:disabled {
    background: transparent;
    border-color: var(--color-border-disabled);
  }
  .btn-icon--ghost:disabled {
    background: transparent;
  }
</style>
