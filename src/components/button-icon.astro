---
import Icon from './icon.astro';
import type { IconName } from './icon.astro';

interface Props {
  /** Nome acessível (aria-label do ícone): obrigatório, o botão não tem texto. */
  label: string;
  icon?: IconName;
  variant?: 'filled' | 'outlined' | 'ghost';
  size?: 'medium' | 'xsmall';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  /** Botão que abre um painel: id do painel (aria-controls, com aria-expanded). */
  controls?: string;
  /** Texto revelado ao lado do ícone no hover e no foco do teclado (Figma 214:2880, ex.: "Busca").
   *  Só visual (aria-hidden): o nome acessível continua em `label`. */
  reveal?: string;
  /** Só para a vitrine (/dev/components): força o visual de hover/foco. */
  state?: 'hover' | 'focus';
}

const {
  label,
  icon = 'info',
  variant = 'filled',
  size = 'medium',
  href,
  type = 'button',
  disabled = false,
  controls,
  reveal,
  state,
} = Astro.props;

const asLink = href !== undefined && !disabled;
const Tag = asLink ? 'a' : 'button';
const attrs = asLink
  ? { href }
  : {
      type,
      disabled,
      'aria-controls': controls,
      'aria-expanded': controls ? ('false' as const) : undefined,
    };
---

<Tag
  class={`btn-icon btn-icon--${variant} btn-icon--${size}`}
  data-reveal={reveal ? '' : undefined}
  data-state={state}
  {...attrs}
>
  <Icon name={icon} size={20} label={label} />
  {
    reveal && (
      <span class="btn-icon__reveal" aria-hidden="true">
        <span class="btn-icon__reveal-clip">
          <span class="btn-icon__reveal-text">{reveal}</span>
        </span>
      </span>
    )
  }
</Tag>

<style>
  .btn-icon {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: var(--border-width-default) solid transparent;
    background: transparent;
    cursor: pointer;
    text-decoration: none;
    /* Troca de estado (hover, foco, painel aberto) suave; tempo e curva do Figma via Caio. */
    transition:
      background-color var(--motion-duration-hover) var(--motion-easing-hover),
      border-color var(--motion-duration-hover) var(--motion-easing-hover),
      color var(--motion-duration-hover) var(--motion-easing-hover);
  }
  @media (prefers-reduced-motion: reduce) {
    .btn-icon {
      transition: none;
    }
  }
  /* Figma (Button only-icon, 123:2668): 48 e 40, ícone de 20 centrado; 2 x inset + 24, sem token. */
  .btn-icon--medium {
    padding: 0;
    width: calc(var(--space-inset-sm) * 2 + var(--primitives-spacing-24));
    height: calc(var(--space-inset-sm) * 2 + var(--primitives-spacing-24));
  }
  .btn-icon--xsmall {
    padding: 0;
    width: calc(var(--space-inset-xs) * 2 + var(--primitives-spacing-24));
    height: calc(var(--space-inset-xs) * 2 + var(--primitives-spacing-24));
  }

  /* Revelar o texto (Figma 214:2880): a largura cresce da esquerda do botão (ancorado à direita
     no cabeçalho) de 48 px até a do conteúdo. A coluna do texto vai de 0fr a 1fr (sem medir
     nada em JS); o texto entra por opacidade, um pouco depois, e sai primeiro. Larguras e
     tempos reaproveitam os tokens do pin (500 ms, curva pin-hover) e do dissolve (150 ms). */
  .btn-icon[data-reveal] {
    width: auto;
    min-width: calc(var(--space-inset-sm) * 2 + var(--primitives-spacing-24));
    /* 48 fechado = borda + padding + ícone de 20: o padding lateral é o que sobra. */
    padding-inline: calc(
      (
          var(--space-inset-sm) * 2 + var(--primitives-spacing-24) -
            var(--primitives-spacing-20)
        ) / 2 - var(--border-width-default)
    );
  }
  .btn-icon__reveal {
    display: grid;
    grid-template-columns: 0fr;
    transition: grid-template-columns var(--motion-duration-pin-hover)
      var(--motion-easing-pin-hover);
  }
  .btn-icon__reveal-clip {
    min-width: 0;
    overflow: hidden;
  }
  .btn-icon__reveal-text {
    display: block;
    padding-left: var(--space-gap-xs);
    white-space: nowrap;
    opacity: 0;
    font-family: var(--s-typo-label-medium-family);
    font-weight: var(--s-typo-label-medium-weight);
    font-size: var(--s-typo-label-medium-size);
    line-height: var(--s-typo-label-medium-line);
    letter-spacing: var(--s-typo-label-medium-spacing);
    transition: opacity var(--motion-duration-dissolve)
      var(--motion-easing-dissolve);
  }
  /* Revela no hover (só com mouse) e no foco do teclado; não com o painel aberto nem desabilitado. */
  @media (hover: hover) {
    .btn-icon[data-reveal]:hover:not(:disabled):not([aria-expanded='true']):not(
        [data-engaged]
      )
      .btn-icon__reveal {
      grid-template-columns: 1fr;
    }
    .btn-icon[data-reveal]:hover:not(:disabled):not([aria-expanded='true']):not(
        [data-engaged]
      )
      .btn-icon__reveal-text {
      opacity: 1;
      transition-delay: 100ms;
    }
  }
  .btn-icon[data-reveal]:focus-visible:not([aria-expanded='true']):not(
      [data-engaged]
    )
    .btn-icon__reveal,
  .btn-icon[data-reveal][data-state]:not([data-engaged]) .btn-icon__reveal {
    grid-template-columns: 1fr;
  }
  .btn-icon[data-reveal]:focus-visible:not([aria-expanded='true']):not(
      [data-engaged]
    )
    .btn-icon__reveal-text,
  .btn-icon[data-reveal][data-state]:not([data-engaged]) .btn-icon__reveal-text {
    opacity: 1;
    transition-delay: 100ms;
  }
  @media (prefers-reduced-motion: reduce) {
    .btn-icon__reveal,
    .btn-icon__reveal-text {
      transition: none;
    }
  }

  .btn-icon:focus-visible,
  .btn-icon[data-state='focus'] {
    outline: var(--border-width-default) solid var(--s-color-border-focus);
    outline-offset: calc(
      var(--primitives-spacing-4) - var(--border-width-default)
    );
  }

  .btn-icon--filled {
    background: var(--s-color-surface-accent-default);
    color: var(--s-color-content-on-accent);
  }
  .btn-icon--filled:hover:not(:disabled),
  .btn-icon--filled[data-state='hover'],
  .btn-icon--filled:focus-visible,
  .btn-icon--filled[data-state='focus'] {
    background: var(--s-color-surface-accent-hover);
  }

  .btn-icon--outlined,
  .btn-icon--ghost {
    background: var(--s-color-surface-default);
    color: var(--s-color-content-primary);
  }
  .btn-icon--outlined {
    border-color: var(--s-color-border-default);
  }
  .btn-icon--outlined:hover:not(:disabled),
  .btn-icon--outlined[data-state='hover'],
  .btn-icon--outlined:focus-visible,
  .btn-icon--outlined[data-state='focus'],
  .btn-icon--ghost:hover:not(:disabled),
  .btn-icon--ghost[data-state='hover'],
  .btn-icon--ghost:focus-visible,
  .btn-icon--ghost[data-state='focus'] {
    background: var(--s-color-surface-hover);
  }

  /* Botão que abre um painel, com o painel em cena: aparência de desabilitado (Figma 126:4529;
     pedido de Caio): superfície padrão e ícone na cor desabilitada, sem hover. O fechamento
     é pelo botão de fechar do painel. `data-engaged` é ligado pelo painel no tempo da animação
     (a 50% da entrada; só depois da saída completa), enquanto `aria-expanded` muda na hora. */
  .btn-icon--filled[data-engaged] {
    background: var(--s-color-surface-default);
    color: var(--s-color-content-disabled);
    cursor: default;
  }
  .btn-icon--ghost[data-engaged] {
    color: var(--s-color-content-disabled);
    cursor: default;
  }
  .btn-icon--ghost[data-engaged]:hover,
  .btn-icon--ghost[data-engaged]:focus-visible {
    background: var(--s-color-surface-default);
  }
  .btn-icon--filled[data-engaged]:hover,
  .btn-icon--filled[data-engaged]:focus-visible {
    background: var(--s-color-surface-default);
  }

  .btn-icon:disabled {
    cursor: not-allowed;
    color: var(--s-color-content-disabled);
  }
  .btn-icon--filled:disabled {
    background: var(--s-color-surface-disabled);
  }
  .btn-icon--outlined:disabled {
    background: transparent;
    border-color: var(--s-color-border-disabled);
  }
  .btn-icon--ghost:disabled {
    background: transparent;
  }
</style>
