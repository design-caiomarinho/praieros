---
import Icon from './icon.astro';
import type { IconName } from './icon.astro';

// Aviso passageiro sobre o mapa (Figma 249:3926): ícone, texto e barra de progresso embaixo, com o
// movimento da faixa de carregando do mapa. Só apresentação: quem a mostra e esconde (e o tempo
// da barra) é index.astro; o leitor de tela anuncia pela região `role="status"` que a envolve.
interface Props {
  icon: IconName;
  text: string;
}

const { icon, text } = Astro.props;
---

<div class="pill">
  <span class="pill__icon">
    <Icon name={icon} size={24} />
  </span>
  <div class="pill__body">
    <span class="pill__text">{text}</span>
    <!-- Barra de progresso: a mesma do carregando do mapa (Figma 249:3951); quem a conduz é index.astro. -->
    <span class="pill__bar">
      <span class="pill__fill"></span>
    </span>
  </div>
</div>

<style>
  .pill {
    display: flex;
    align-items: center;
    background: var(--color-surface-default);
    /* Aparece como o nome do pin (Figma 204:7892), como a pílula de carregando: opacidade 0 → 1
       e de baixo para cima (+8px → 0); ao sair (`data-leaving`), o inverso (`pill-out`). */
    animation: pill-in var(--motion-duration-pin-label)
      var(--motion-easing-pin-label) both;
  }
  /* Saída: o inverso da entrada, com a mesma curva e tempo. É uma animação própria (nome diferente)
     porque inverter a direção da entrada, já terminada, não anima: o estado só pula. */
  .pill[data-leaving] {
    animation-name: pill-out;
  }
  @keyframes pill-out {
    from {
      opacity: 1;
      translate: 0 0;
    }
    to {
      opacity: 0;
      translate: 0 var(--space-stack-xs);
    }
  }
  @keyframes pill-in {
    from {
      opacity: 0;
      translate: 0 var(--space-stack-xs);
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pill {
      animation: none;
    }
  }
  .pill[hidden] {
    display: none;
  }
  .pill__icon {
    display: flex;
    padding: var(--space-inset-md);
    background: var(--color-surface-accent-default);
    color: var(--color-content-on-accent);
  }
  .pill__body {
    display: flex;
    flex-direction: column;
    border: var(--border-width-default) solid var(--color-border-default);
    border-left: 0;
  }
  .pill__text {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    height: 48px;
    padding: var(--space-inset-sm) var(--space-inset-md);
    color: var(--color-content-secondary);
    font-family: var(--typo-body-medium-family);
    font-weight: var(--typo-body-medium-weight);
    font-size: var(--typo-body-medium-size);
    line-height: var(--typo-body-medium-line);
    letter-spacing: var(--typo-body-medium-spacing);
    white-space: nowrap;
  }
  /* Barra de 8 px sob o texto; o azul avança até 90% e espera (index.astro completa e some). */
  .pill__bar {
    display: block;
    height: var(--primitives-spacing-8);
    overflow: clip;
  }
  .pill__fill {
    display: block;
    height: 100%;
    background: var(--color-surface-accent-default);
    transform: scaleX(0);
    transform-origin: left;
    animation: pill-progress var(--motion-duration-load-progress)
      var(--motion-easing-hover) forwards;
  }
  @keyframes pill-progress {
    to {
      transform: scaleX(0.9);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pill__fill {
      animation: none;
      transform: scaleX(0.9);
    }
  }
</style>
