---
import StatusChip from './status-chip.astro';
import type { ChipStatus } from '../lib/rules/status.ts';

// Cartão de ponto de coleta (Figma, nó 125:3704, estado no-result). Com `pointId` é clicável (um
// botão): escolhe o pin do ponto no mapa; hover e foco seguem o padrão dos itens da busca.
interface Props {
  /** Id do ponto no mapa: liga o cartão ao pin (clique escolhe o pin; outros esmaecem). */
  pointId?: string;
  name: string;
  location?: string;
  status: ChipStatus;
  /** Posição automática no mapa. Guardada, mas não exibida (o Figma não tem o aviso). */
  accuracy?: 'approximate' | 'very-approximate' | null;
}

const { pointId, name, location, status } = Astro.props;
const Tag = pointId ? 'button' : 'article';
---

<Tag
  class={`card card--${status}`}
  data-point-id={pointId}
  type={pointId ? 'button' : undefined}
>
  <span class="body">
    <span class="header">
      <StatusChip status={status} />
      <span class="indicator" aria-hidden="true"></span>
    </span>
    <span class="text">
      <span class="name">{name}</span>
      {location && <span class="location">{location}</span>}
    </span>
  </span>
</Tag>

<style>
  .card {
    box-sizing: border-box;
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    background: none;
    border: 0;
    border-left: var(--border-width-accent) solid;
    color: inherit;
    font: inherit;
    text-align: left;
  }
  button.card {
    cursor: pointer;
  }
  /* Hover e foco (teclado) como os itens da busca: superfície de hover; foco com anel. */
  button.card:hover .body,
  button.card:focus-visible .body {
    background: var(--s-color-surface-hover);
  }
  button.card:focus-visible {
    outline: var(--border-width-default) solid var(--s-color-border-focus);
    outline-offset: var(--primitives-spacing-4);
  }
  /* Só no-result vem no Figma; as outras cores seguem os tokens de borda de cada status. */
  .card--suitable {
    --edge: var(--s-color-border-positive);
  }
  .card--unsuitable {
    --edge: var(--s-color-border-negative);
  }
  .card--outdated {
    --edge: var(--s-color-border-warning);
  }
  .card--no-result {
    --edge: var(--s-color-border-unknown);
  }
  .card {
    border-left-color: var(--edge);
  }
  /* O ponto escolhido (pin ativo no mapa): a borda cinza dá lugar à borda da cor do status, sem
     hover e sem clique (pedido de Caio). Os outros seguem com o hover de sempre. */
  .body {
    transition:
      background-color var(--motion-duration-hover) var(--motion-easing-hover),
      border-color var(--motion-duration-hover) var(--motion-easing-hover);
  }
  .card[data-current] {
    cursor: default;
    pointer-events: none;
  }
  .card[data-current] .body {
    border-color: var(--edge);
  }
  @media (prefers-reduced-motion: reduce) {
    .body {
      transition: none;
    }
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-md);
    padding: var(--space-inset-md);
    border: var(--border-width-default) solid var(--s-color-border-default);
    border-left: 0;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-xs);
  }
  /* Indicador (Figma 220:7763): anel de 24 px com a borda cinza do cartão; só o ponto escolhido
     ganha a borda do status e o miolo de 16 px (premissa de Caio, ver decisions). O miolo entra
     como o nome do pin (opacidade, curva `pin-label`), mas por escala (0 a 1) e mais rápido. */
  .indicator {
    --dot: var(--s-color-surface-unknown-default);
    --ring: var(--s-color-border-unknown);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--primitives-spacing-24);
    height: var(--primitives-spacing-24);
    border: var(--border-width-default) solid var(--s-color-border-default);
    border-radius: var(--radius-full);
    transition: border-color var(--motion-duration-pin-hover)
      var(--motion-easing-pin-label);
  }
  .indicator::after {
    content: '';
    width: var(--primitives-spacing-16);
    height: var(--primitives-spacing-16);
    border-radius: var(--radius-full);
    background: var(--dot);
    opacity: 0;
    transform: scale(0);
    transition:
      opacity var(--motion-duration-pin-hover) var(--motion-easing-pin-label),
      transform var(--motion-duration-pin-hover) var(--motion-easing-pin-label);
  }
  .card--suitable .indicator {
    --dot: var(--s-color-surface-positive-default);
    --ring: var(--s-color-border-positive);
  }
  .card--unsuitable .indicator {
    --dot: var(--s-color-surface-negative-default);
    --ring: var(--s-color-border-negative);
  }
  .card--outdated .indicator {
    --dot: var(--s-color-surface-warning-default);
    --ring: var(--s-color-border-warning);
  }
  .card[data-current] .indicator {
    border-color: var(--ring);
  }
  .card[data-current] .indicator::after {
    opacity: 1;
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .indicator,
    .indicator::after {
      transition: none;
    }
  }
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-gap-xs);
  }
  .name {
    margin: 0;
    color: var(--s-color-content-primary);
    font-family: var(--s-typo-body-large-family);
    font-weight: var(--primitives-font-weight-600);
    font-size: var(--s-typo-body-large-size);
    line-height: var(--s-typo-body-large-line);
    letter-spacing: var(--s-typo-body-large-spacing);
  }
  .name,
  .location {
    display: block;
  }
  .location {
    display: block;
    margin: 0;
    color: var(--s-color-content-secondary);
    font-family: var(--s-typo-body-medium-family);
    font-weight: var(--s-typo-body-medium-weight);
    font-size: var(--s-typo-body-medium-size);
    line-height: var(--s-typo-body-medium-line);
    letter-spacing: var(--s-typo-body-medium-spacing);
  }
</style>
