---
import StatusChip from './status-chip.astro';
import type { ChipStatus } from '../lib/rules/status.ts';
import { ACCURACY_LABELS } from '../lib/site/accuracy.ts';

// Cartão de ponto de coleta (Figma, nó 125:3704, estado no-result).
interface Props {
  /** Id do ponto no mapa: o cartão fica clicável e liga ao pin numerado. */
  pointId?: string;
  name: string;
  location?: string;
  status: ChipStatus;
  /** Posição automática no mapa (copy provisória, pendente de componentizar no Figma). */
  accuracy?: 'approximate' | 'very-approximate' | null;
}

const { pointId, name, location, status, accuracy = null } = Astro.props;
const accuracyLabel = accuracy ? ACCURACY_LABELS[accuracy] : null;
---

<article
  class={`card card--${status}`}
  data-point-id={pointId}
  tabindex={pointId ? 0 : undefined}
>
  <div class="body">
    <div class="header">
      <h3>{name}</h3>
      <StatusChip status={status} />
    </div>
    {location && <p class="location">{location}</p>}
    {accuracyLabel && (
      <p class:list={['location', 'accuracy', `accuracy--${accuracy}`]}>
        {accuracyLabel}
      </p>
    )}
  </div>
</article>

<style>
  .card {
    box-sizing: border-box;
    border-left: var(--border-width-accent) solid;
  }
  /* Só no-result vem no Figma; as outras cores seguem os tokens de borda de cada status. */
  .card--suitable {
    border-left-color: var(--s-color-border-positive);
  }
  .card--unsuitable {
    border-left-color: var(--s-color-border-negative);
  }
  .card--outdated {
    border-left-color: var(--s-color-border-warning);
  }
  .card--no-result {
    border-left-color: var(--s-color-border-unknown);
  }
  .card[data-point-id] {
    cursor: pointer;
  }
  /* Ponto ativo (pin escolhido no mapa). */
  .card[data-dimmed] {
    opacity: 0.5;
  }
  .card[data-active] .body {
    border-color: var(--s-color-border-accent);
    background: var(--s-color-surface-accent-subtle);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-xs);
    padding: var(--space-inset-md);
    border: var(--border-width-default) solid var(--s-color-border-default);
    border-left: 0;
  }
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-gap-xs);
  }
  h3 {
    margin: 0;
    color: var(--s-color-content-primary);
    font-family: var(--s-typo-body-large-family);
    font-weight: var(--primitives-font-weight-600);
    font-size: var(--s-typo-body-large-size);
    line-height: var(--s-typo-body-large-line);
    letter-spacing: var(--s-typo-body-large-spacing);
  }
  .location {
    margin: 0;
    color: var(--s-color-content-secondary);
    font-family: var(--s-typo-body-medium-family);
    font-weight: var(--s-typo-body-medium-weight);
    font-size: var(--s-typo-body-medium-size);
    line-height: var(--s-typo-body-medium-line);
    letter-spacing: var(--s-typo-body-medium-spacing);
  }
  /* Quanto menos exata a posição, mais claro o aviso (texto provisório, pendente no Figma). */
  .accuracy--very-approximate {
    color: var(--s-color-content-warning);
    font-weight: var(--s-typo-label-medium-weight);
  }
</style>
