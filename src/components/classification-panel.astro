---
import Button from './button.astro';
import ButtonIcon from './button-icon.astro';
import StatusChip from './status-chip.astro';
import {
  CLASSIFICATION_INTRO,
  CONAMA_URL,
  type ClassificationContent,
} from '../lib/site/classification.ts';

// Painel Classificação (Figma 125:3895, desktop). Só apresentação: recebe os textos prontos
// (escolhidos por `classificationFor`). O botão de voltar e o de fechar são ligados em index.astro.
interface Props {
  content: ClassificationContent;
  /** PDF do boletim que já está no modelo da praia. */
  pdfUrl: string;
  /** Nome da praia, só para o rótulo acessível do painel. */
  beachName: string;
}

const { content, pdfUrl, beachName } = Astro.props;
---

<section class="panel" aria-label={`Classificação: ${beachName}`} tabindex="-1">
  <header class="head">
    <div class="top">
      <div class="title">
        <div class="back" data-classification-back>
          <ButtonIcon
            variant="ghost"
            size="xsmall"
            icon="arrow-left"
            label="Voltar à ficha da praia"
          />
        </div>
        <h2>Classificação</h2>
      </div>
      <div class="close" data-panel-close>
        <ButtonIcon
          variant="ghost"
          size="xsmall"
          icon="close"
          label="Fechar classificação"
        />
      </div>
    </div>
  </header>

  <div class="scroll" data-scroll>
    <div class="body">
      <div class="main">
        <div class="blocks">
          <p class="intro">{CLASSIFICATION_INTRO}</p>
          <div class="block">
            <h3>Na fonte</h3>
            <p>{content.source}</p>
          </div>
          <div class="block">
            <h3>Em linguagem simples</h3>
            <p>{content.plain}</p>
          </div>
          <div class="block">
            <h3>Status</h3>
            <div class="chip">
              <StatusChip status={content.status} />
            </div>
            <p>{content.statusText}</p>
          </div>
        </div>
        <div class="share">
          <Button variant="primary" disabled>
            Compartilhar praia
          </Button>
        </div>
      </div>
    </div>

    <footer class="foot-wrap">
      <div class="foot">
        <div class="links">
          <Button
            variant="secondary"
            href={CONAMA_URL}
            target="_blank"
            spread
            iconRight="external"
          >
            Ver resolução
          </Button>
          <Button
            variant="secondary"
            href={pdfUrl}
            target="_blank"
            spread
            iconRight="external"
          >
            Boletim original
          </Button>
        </div>
        <p class="credit">Fonte: Inema · Praieros não é canal oficial</p>
      </div>
    </footer>
  </div>
</section>

<style>
  .panel {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    width: var(--size-panel-width);
    max-width: 100%;
    background: var(--s-color-surface-default);
    color: var(--s-color-content-primary);
    border-left: var(--border-width-default) solid var(--s-color-border-default);
  }
  /* Recebe o foco ao abrir (sem anel: não é um controle). */
  .panel:focus {
    outline: none;
  }
  /* Cabeçalho (Figma 222:8902): só o título, padding 16 vertical e 24 lateral, borda inferior. */
  .head {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    padding: var(--space-inset-md) var(--space-inset-lg);
    border-bottom: var(--border-width-default) solid
      var(--s-color-border-default);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-gap-md);
  }
  .title {
    display: flex;
    align-items: center;
    gap: var(--space-gap-xs);
    min-width: 0;
  }
  .back,
  .close {
    display: contents;
  }
  h2 {
    margin: 0;
    color: var(--s-color-content-primary);
    font-family: var(--s-typo-heading-large-family);
    font-weight: var(--s-typo-heading-large-weight);
    font-size: var(--s-typo-heading-large-size);
    line-height: var(--s-typo-heading-large-line);
    letter-spacing: var(--s-typo-heading-large-spacing);
  }
  .intro,
  .block p {
    margin: 0;
    color: var(--s-color-content-secondary);
    font-family: var(--s-typo-body-medium-family);
    font-weight: var(--s-typo-body-medium-weight);
    font-size: var(--s-typo-body-medium-size);
    line-height: var(--s-typo-body-medium-line);
    letter-spacing: var(--s-typo-body-medium-spacing);
  }
  /* Área que rola (corpo + rodapé): o cabeçalho fica fora dela, então a barra de rolagem começa
     abaixo dele (pedido de Caio). */
  .scroll {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
    overflow-y: auto;
  }
  /* Corpo (Figma 222:8908): padding 24; texto de abertura, blocos (32) e botão (40). */
  .body {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    padding: var(--space-inset-lg);
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-2xl);
  }
  /* Rodapé (Figma 222:8934): borda no topo, padding 24, links e crédito. */
  .foot-wrap {
    padding: var(--space-inset-lg);
    border-top: var(--border-width-default) solid var(--s-color-border-default);
  }
  .blocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-xl);
  }
  .block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-gap-md);
  }
  h3 {
    margin: 0;
    color: var(--s-color-content-muted);
    font-family: var(--s-typo-body-small-family);
    font-weight: var(--s-typo-body-small-weight);
    font-size: var(--s-typo-body-small-size);
    line-height: var(--s-typo-body-small-line);
    letter-spacing: var(--s-typo-body-small-spacing);
  }
  /* Mobile, folha inferior (mesmo padrão da ficha): sem largura fixa, borda no topo, padding 16
     lateral e 24 vertical no cabeçalho e no corpo, área segura embaixo. */
  @media (max-width: 1023px) {
    .panel {
      width: auto;
      border-left: 0;
      border-top: var(--border-width-default) solid
        var(--s-color-border-default);
    }
    .head {
      padding: var(--space-inset-md);
    }
    .body {
      padding: var(--space-inset-lg) var(--space-inset-md);
    }
    .foot-wrap {
      padding: var(--space-inset-lg) var(--space-inset-md);
      padding-bottom: calc(
        var(--space-inset-lg) + env(safe-area-inset-bottom, 0px)
      );
    }
    /* Alvo de toque do fechar de 44px (40px desenhados), como na ficha. */
    .close :global(.btn-icon) {
      position: relative;
    }
    .close :global(.btn-icon)::after {
      content: '';
      position: absolute;
      inset: calc(var(--primitives-spacing-4) / -2);
    }
  }
  .share > :global(*) {
    width: 100%;
    justify-content: center;
  }
  .foot {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-md);
  }
  /* Desktop: lado a lado (Figma 222:8936); no mobile empilham (ver a ficha). */
  .links {
    display: flex;
    flex-direction: row;
    gap: var(--space-stack-xs);
  }
  .links > :global(*) {
    flex: 1 1 0;
    min-width: 0;
  }
  @media (max-width: 1023px) {
    .links {
      flex-direction: column;
    }
  }
  .credit {
    margin: 0;
    color: var(--s-color-content-muted);
    font-family: var(--s-typo-caption-small-family);
    font-weight: var(--s-typo-caption-small-weight);
    font-size: var(--s-typo-caption-small-size);
    line-height: var(--s-typo-caption-small-line);
    letter-spacing: var(--s-typo-caption-small-spacing);
  }
</style>
