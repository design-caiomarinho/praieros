---
import Button from './button.astro';
import ButtonIcon from './button-icon.astro';
import Icon from './icon.astro';
import type { MarkerData } from '../lib/site/map-markers.ts';

// Mapa das praias (MapLibre) com os estados carregando e indisponível e os controles de zoom.
// Só estrutura e interação do mapa: o painel da ficha fica na página, que conversa com este
// componente por eventos (`marker-select` sai daqui; `marker-set` entra).
// Textos de carregando e erro: Figma 117:4816 e 117:4959 (docs/copy.md).
interface Props {
  markers: MarkerData[];
}

const { markers } = Astro.props;
// "<" escapado para o JSON não fechar o <script> por engano.
const markersJson = JSON.stringify(markers).replace(/</g, '\\u003c');
---

<div class="map-root" id="beach-map">
  <div
    class="canvas"
    id="map-canvas"
    role="region"
    aria-label="Mapa das praias"
  ></div>

  <div
    class="loadbar"
    id="map-loading"
    role="status"
    aria-label="Carregando o mapa"
  >
    <span class="loadbar__fill"></span>
  </div>

  <div class="error" id="map-error" hidden>
    <div class="error__box">
      <span class="error__icon">
        <Icon name="warning" />
      </span>
      <div class="error__content">
        <div class="error__texts">
          <h2>Não conseguimos carregar o mapa</h2>
          <p>Tente de novo ou busque uma praia pelo nome.</p>
        </div>
        <div class="error__action" id="map-retry">
          <Button variant="primary" size="small">
            Tente novamente
          </Button>
        </div>
      </div>
    </div>
  </div>

  <div class="zoom" id="map-zoom">
    <div data-zoom="in">
      <ButtonIcon
        variant="outlined"
        size="xsmall"
        icon="plus"
        label="Aumentar o zoom"
      />
    </div>
    <div data-zoom="out">
      <ButtonIcon
        variant="outlined"
        size="xsmall"
        icon="minus"
        label="Diminuir o zoom"
      />
    </div>
    <div data-zoom="fit">
      <ButtonIcon
        variant="outlined"
        size="xsmall"
        icon="fit-screen"
        label="Ajustar o mapa à tela"
      />
    </div>
  </div>

  <script
    type="application/json"
    id="map-markers"
    set:html={markersJson}
    is:inline
  ></script>
</div>

<script>
  import {
    createBeachMap,
    type BeachMapController,
  } from './beach-map/controller.ts';
  import type { MarkerData } from '../lib/site/map-markers.ts';
  import { parseCubicBezier } from '../lib/map/cubic-bezier.ts';

  const root = document.getElementById('beach-map')!;
  const canvas = document.getElementById('map-canvas')!;
  const loading = document.getElementById('map-loading')!;
  const errorBox = document.getElementById('map-error')!;
  const zoom = document.getElementById('map-zoom')!;
  const markers: MarkerData[] = JSON.parse(
    document.getElementById('map-markers')!.textContent ?? '[]',
  );

  const token = (name: string) =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  const palette = () => ({
    land: token('--s-color-surface-strong'),
    water: token('--s-color-surface-accent-soft'),
    park: token('--s-color-surface-positive-soft'),
    sand: token('--s-color-surface-warning-subtle'),
    block: token('--s-color-surface-emphasis'),
    road: token('--s-color-surface-default'),
  });

  // Desktop: o sidebar (busca, ficha, Classificação, Fonte) sobrepõe o mapa pela direita. Enquanto
  // algum painel está aberto, a câmera usa só a área visível à esquerda (largura do painel).
  const desktop = window.matchMedia('(min-width: 1024px)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  // Mobile: a folha inferior cobre 60% do palco (altura definida em index.astro).
  const SHEET_RATIO = 0.6;
  const covered = () => {
    const open = ['search', 'panel', 'source-slot'].some(
      (id) => !document.getElementById(id)?.hidden,
    );
    if (!open) return { right: 0, bottom: 0 };
    if (!desktop.matches)
      return { right: 0, bottom: root.clientHeight * SHEET_RATIO };
    const w = parseFloat(
      getComputedStyle(document.documentElement).getPropertyValue(
        '--size-panel-width',
      ),
    );
    return { right: w || 0, bottom: 0 };
  };
  // Movimentos da câmera: mesma duração e curva do painel (sem animação com movimento reduzido).
  const motion = () => {
    const css = getComputedStyle(document.documentElement);
    return {
      duration: reduceMotion.matches
        ? 0
        : parseFloat(css.getPropertyValue('--motion-duration-panel')) || 0,
      easing: parseCubicBezier(css.getPropertyValue('--motion-easing-panel')),
    };
  };
  // O sidebar abre: leva a praia selecionada para a área visível, se ela ficar escondida.
  document.addEventListener('sidebar-open', () => controller?.revealSelected());
  // Painel fechado com o pin ainda marcado: a câmera volta a centralizá-lo na área toda.
  document.addEventListener('sidebar-close', () =>
    controller?.recenterSelected(),
  );

  let controller: BeachMapController | null = null;
  let selectedSlug: string | null = null;
  let selectedPointId: string | null = null;

  // Faixa de carregamento sob a navbar: o azul avança da esquerda para a direita e, com o mapa
  // pronto, completa; ao chegar ao fim some e o mapa faz o zoom out até o enquadramento.
  const fill = loading.querySelector<HTMLElement>('.loadbar__fill')!;
  let loadingTimer: number | undefined;
  function resetBar() {
    window.clearTimeout(loadingTimer);
    fill.removeAttribute('style');
    loading.removeAttribute('data-leaving');
  }
  function finishBar(zoomOut: boolean) {
    if (reduceMotion.matches || !zoomOut) {
      loading.hidden = true;
      if (zoomOut) {
        root.setAttribute('data-revealed', '');
        controller?.fit();
      }
      return;
    }
    const finish = parseFloat(token('--motion-duration-hover')) || 0;
    const progress = getComputedStyle(fill).transform;
    fill.style.animation = 'none';
    fill.style.transform = progress;
    void fill.offsetWidth;
    fill.style.transition = `transform ${finish}ms var(--motion-easing-hover)`;
    fill.style.transform = 'scaleX(1)';
    loadingTimer = window.setTimeout(() => {
      root.setAttribute('data-revealed', ''); // faixa em 100%: o mapa aparece
      fill.style.animation = ''; // a saída (CSS) assume: sobe para trás da navbar
      loading.setAttribute('data-leaving', '');
      controller?.fit(); // zoom out: 1 nível acima → enquadramento, com o tempo e a curva da câmera
      loadingTimer = window.setTimeout(
        () => {
          loading.hidden = true;
          loading.removeAttribute('data-leaving');
        },
        parseFloat(token('--motion-duration-pin-label')) || 0,
      );
    }, finish);
  }
  function show(state: 'loading' | 'ready' | 'error') {
    root.toggleAttribute('data-ready', state === 'ready');
    if (state === 'loading') {
      root.removeAttribute('data-revealed');
      resetBar();
      loading.hidden = false;
    } else if (!loading.hidden) {
      window.clearTimeout(loadingTimer);
      finishBar(state === 'ready');
    }
    errorBox.hidden = state !== 'error';
    zoom.hidden = state === 'error';
  }

  async function start() {
    controller?.destroy();
    controller = null;
    canvas.replaceChildren();
    // Cria o controlador antes do estado, para o retry não deixar mapas pendurados.
    controller = await createBeachMap({
      container: canvas,
      markers,
      palette: palette(),
      onSelect: (detail) => {
        root.dispatchEvent(
          new CustomEvent('marker-select', { bubbles: true, detail }),
        );
      },
      onClear: () => {
        root.dispatchEvent(new CustomEvent('map-clear', { bubbles: true }));
      },
      getCovered: covered,
      getMotion: motion,
      onState: (s) => {
        show(s);
        if (s === 'error') {
          controller?.destroy();
          controller = null;
        }
      },
    });
    if (controller && selectedSlug)
      controller.select(selectedSlug, selectedPointId);
    // Só em dev: acesso ao mapa para conferir zoom e posições no navegador.
    if (controller && import.meta.env.DEV)
      (window as unknown as { __beachMap?: unknown }).__beachMap =
        controller.getMap();
  }

  // Um painel abrindo ou fechando muda a largura do mapa. Redimensiona o canvas na hora, sem
  // depender só do observador do MapLibre (sobrava uma faixa do fundo junto ao painel).
  // Só o atributo hidden dos painéis: observar os marcadores geraria laço com o 'resize'.
  const syncSize = new MutationObserver(() => controller?.getMap().resize());
  ['panel', 'search'].forEach((id) => {
    const el = document.getElementById(id);
    if (el)
      syncSize.observe(el, { attributes: true, attributeFilter: ['hidden'] });
  });

  root.addEventListener('marker-focus', (e) => {
    const { slug } = (e as CustomEvent<{ slug: string }>).detail;
    controller?.focusBeach(slug);
  });
  // Bairro escolhido na busca: enquadra as praias dele na área visível (sem o painel por cima).
  root.addEventListener('map-fit', (e) => {
    const { slugs } = (e as CustomEvent<{ slugs: string[] }>).detail;
    controller?.fitBeaches(slugs);
  });
  root.addEventListener('marker-set', (e) => {
    const d = (
      e as CustomEvent<{ slug: string | null; pointId?: string | null }>
    ).detail;
    selectedSlug = d.slug;
    selectedPointId = d.pointId ?? null;
    controller?.select(selectedSlug, selectedPointId);
  });
  zoom.addEventListener('click', (e) => {
    const kind = (e.target as Element)
      .closest<HTMLElement>('[data-zoom]')
      ?.getAttribute('data-zoom');
    if (kind === 'in') controller?.zoomIn();
    if (kind === 'out') controller?.zoomOut();
    if (kind === 'fit') controller?.fit();
  });
  document.getElementById('map-retry')!.addEventListener('click', () => {
    void start();
  });

  void start();
</script>

<style>
  .map-root {
    position: relative;
    flex: 1;
    min-width: 0;
    /* Cor do mar desde o primeiro quadro (sem cinza antes dos tiles). */
    background: var(--s-color-surface-accent-soft);
    overflow: clip;
    /* Contexto próprio: a ficha (folha inferior) fica acima dos controles do MapLibre. */
    isolation: isolate;
  }
  /* O canvas do MapLibre é focável (tabindex 0): sem anel do navegador na borda do mapa, que
     aparecia como uma faixa azul grossa junto ao painel. Os marcadores têm o próprio foco. */
  :global(.maplibregl-canvas:focus),
  :global(.maplibregl-canvas:focus-visible),
  :global(.maplibregl-canvas-container:focus-visible) {
    outline: none;
  }
  .canvas {
    position: absolute;
    /* Passa da borda direita (o contêiner corta, overflow: clip): em telas com escala de pixels
       fracionária sobrava uma fresta do fundo (cor do mar) entre o mapa e a borda do painel. */
    inset: 0 calc(var(--primitives-spacing-4) * -1) 0 0;
    /* Escondido até o primeiro desenho: mostra o fundo do mar, não o terreno sem tiles. */
    opacity: 0;
  }
  /* O mapa só aparece quando a faixa de carregamento chega a 100% (data-revealed). */
  .map-root[data-revealed] .canvas {
    opacity: 1;
  }

  /* Carregando: faixa de ponta a ponta sob a navbar; o azul avança da esquerda para a direita
     (sem fim até o mapa ficar pronto: chega a 90% e espera) e some ao completar. */
  .loadbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 3;
    height: var(--primitives-spacing-4);
    /* Recorta: a faixa sobe para trás da navbar ao completar. */
    overflow: clip;
  }
  /* Saída: sobe além do topo (-200%) com a curva e o tempo da saída da faixa de aviso. */
  .loadbar[data-leaving] .loadbar__fill {
    animation: loadbar-out var(--motion-duration-pin-label)
      var(--motion-easing-pin-label) both;
  }
  @keyframes loadbar-out {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 -200%;
    }
  }
  .loadbar__fill {
    display: block;
    height: 100%;
    background: var(--s-color-surface-accent-default);
    transform: scaleX(0);
    transform-origin: left;
    animation: loadbar-progress var(--motion-duration-load-progress)
      var(--motion-easing-panel) forwards;
  }
  @keyframes loadbar-progress {
    to {
      transform: scaleX(0.9);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .loadbar,
    .loadbar__fill {
      transition: none;
    }
    .loadbar__fill {
      animation: none;
      transform: scaleX(0.9);
    }
  }
  .loadbar[hidden],
  .error[hidden],
  .zoom[hidden] {
    display: none;
  }

  /* Indisponível (Figma 117:5012): bloco centralizado sobre o fundo neutro. */
  .error {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--s-color-surface-strong);
  }
  .error__box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-gap-xl);
  }
  .error__icon {
    display: flex;
    padding: var(--space-inset-sm);
    background: var(--s-color-surface-accent-subtle);
    color: var(--s-color-content-accent);
  }
  .error__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-lg);
    width: 230px;
  }
  .error__texts {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-gap-md);
    text-align: center;
  }
  .error__texts h2 {
    margin: 0;
    color: var(--s-color-content-primary);
    font-family: var(--s-typo-heading-large-family);
    font-weight: var(--s-typo-heading-large-weight);
    font-size: var(--s-typo-heading-large-size);
    line-height: var(--s-typo-heading-large-line);
    letter-spacing: var(--s-typo-heading-large-spacing);
  }
  .error__texts p {
    margin: 0;
    color: var(--s-color-content-secondary);
    font-family: var(--s-typo-body-medium-family);
    font-weight: var(--s-typo-body-medium-weight);
    font-size: var(--s-typo-body-medium-size);
    line-height: var(--s-typo-body-medium-line);
    letter-spacing: var(--s-typo-body-medium-spacing);
  }
  .error__action :global(.btn) {
    width: 100%;
  }

  /* Zoom (Figma 117:4828): pilha no canto inferior direito. */
  .zoom {
    position: absolute;
    right: var(--space-inset-lg);
    bottom: var(--space-inset-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-2xs);
  }

  /* Mobile: a atribuição fica no topo do mapa, acima da folha da ficha (que cobre a base). */
  @media (max-width: 1023.98px) {
    :global(.maplibregl-ctrl-bottom-left) {
      top: 0;
      bottom: auto;
    }
    /* Figma 117:4762 / 117:4916: zoom a 16px das bordas. A pílula de carregamento é igual à do
       desktop (decisão de Caio). */
    .zoom {
      right: max(var(--space-inset-md), env(safe-area-inset-right));
      bottom: max(var(--space-inset-md), env(safe-area-inset-bottom));
    }
  }

  /* Marcadores (Figma 117:4522). Criados por JS: estilos globais. */
  :global(.marker) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-stack-xs);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--s-typo-label-medium-family);
    font-weight: var(--s-typo-label-medium-weight);
    font-size: var(--s-typo-label-medium-size);
    line-height: 1;
  }
  :global(.marker[hidden]) {
    display: none;
  }
  /* Selo ao lado do ícone: total de pontos da praia ou número do pin. */
  :global(.marker__tag) {
    box-sizing: border-box;
    position: absolute;
    top: 0;
    left: calc(50% + 16px);
    width: 24px;
    height: 24px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: var(--border-width-default) solid var(--s-color-border-default);
    border-radius: var(--radius-full);
    background: var(--s-color-surface-default);
    color: var(--s-color-content-primary);
    white-space: nowrap;
    transition: top var(--motion-duration-pin-select)
      var(--motion-easing-pin-hover);
  }
  /* Selecionado: a ponta do pino fica sobre o ponto (12px acima da base do círculo) e a cabeça
     dele, 14,6px acima do centro do círculo. O selo acompanha a cabeça (centrado nela) e o nome
     sobe os mesmos 12px, para manter a mesma distância até o pino. */
  :global(.marker--selected .marker__tag) {
    top: -15px;
  }
  :global(.marker--selected .marker__label) {
    top: calc(100% - 12px);
  }
  /* Nome (Figma 204:7892): fica sob o ícone, fora do fluxo (o marcador mede só o ícone, sem
     aumentar a área de clique sobre os vizinhos). Aparece com opacidade 0 → 1 e a distância ao
     ícone 0 → 8px (token de espaço), na curva e no tempo do Figma; o movimento contrário usa a
     mesma curva e o mesmo tempo. Escondido: invisível, sem clique. */
  :global(.marker__label) {
    position: absolute;
    top: 100%;
    left: 50%;
    margin-top: 0;
    transform: translateX(-50%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--motion-duration-pin-label) var(--motion-easing-pin-label),
      margin-top var(--motion-duration-pin-label) var(--motion-easing-pin-label),
      top var(--motion-duration-pin-select) var(--motion-easing-pin-hover),
      visibility 0s linear var(--motion-duration-pin-label);
  }
  :global(.marker[data-label='shown'] .marker__label),
  :global(.marker[data-label='peek'] .marker__label) {
    margin-top: var(--space-stack-xs);
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  /* Nome fixo (com espaço): o clique no nome também vale para o marcador. Como dica (peek) não:
     não cobre pins vizinhos. */
  :global(.marker[data-label='shown'] .marker__label) {
    pointer-events: auto;
  }
  /* Hover (com ou sem o nome visível) e foco do teclado: o ícone cresce (Figma 204:7892). */
  :global(.marker__badge) {
    transition: transform var(--motion-duration-pin-hover)
      var(--motion-easing-pin-hover);
  }
  :global(.marker:hover .marker__badge),
  :global(.marker:focus-visible .marker__badge) {
    transform: scale(var(--motion-scale-pin-hover));
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.marker),
    :global(.marker__label),
    :global(.marker__disc),
    :global(.marker__pin),
    :global(.marker__badge) {
      transition: none;
    }
  }
  /* O clique vale para o marcador todo (ícone, selo e nome), não para o SVG de dentro. */
  :global(.marker > *) {
    pointer-events: none;
  }
  :global(.marker__badge) {
    position: relative;
    width: 24px;
    height: 24px;
  }
  :global(.marker__disc),
  :global(.marker__pin) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  :global(.marker__disc) {
    box-sizing: border-box;
    padding: var(--space-inset-2xs);
    border: var(--border-width-default) solid;
    border-radius: var(--radius-full);
    overflow: clip;
  }
  /* Selecionar: o círculo (centrado no ponto) encolhe no lugar e some enquanto o pino cresce a
     partir da ponta, que fica sempre sobre o ponto (a camada do pino sobe 12px do círculo). Nada
     se desloca: só escala e opacidade, então a troca entre pontos não "pula". Mesmo tempo e curva
     do hover do pin (derivado; o Figma não define a troca). Desselecionar é o inverso. */
  :global(.marker__pin) {
    inset: -12px 0 12px;
    transform-origin: 50% 100%;
  }
  /* A parte do pino acima do marcador também recebe o clique. */
  :global(.marker--selected::before) {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -12px;
    height: 12px;
  }
  :global(.marker__disc),
  :global(.marker__pin) {
    transition:
      opacity var(--motion-duration-pin-select) var(--motion-easing-pin-hover),
      transform var(--motion-duration-pin-select) var(--motion-easing-pin-hover),
      background-color var(--motion-duration-hover) var(--motion-easing-hover),
      border-color var(--motion-duration-hover) var(--motion-easing-hover),
      color var(--motion-duration-hover) var(--motion-easing-hover);
  }
  :global(.marker__pin) {
    opacity: 0;
    transform: scale(0.4);
    color: var(--s-color-surface-accent-default);
  }
  :global(.marker--selected .marker__pin) {
    opacity: 1;
    transform: none;
  }
  :global(.marker--selected .marker__disc) {
    opacity: 0;
    transform: scale(0.4);
  }
  :global(.marker__label) {
    box-sizing: border-box;
    padding: var(--space-inset-2xs) var(--space-inset-xs);
    border: var(--border-width-default) solid;
    border-radius: var(--radius-full);
    white-space: nowrap;
    text-align: center;
  }
  :global(.marker:focus-visible) {
    outline: var(--border-width-default) solid var(--s-color-border-focus);
    outline-offset: var(--space-inset-2xs);
  }
  :global(.marker--positive .marker__disc) {
    background: var(--s-color-surface-positive-default);
    border-color: var(--s-color-border-positive);
    color: var(--s-color-content-positive);
  }
  :global(.marker--positive .marker__label) {
    background: var(--s-color-surface-positive-translucid);
    border-color: var(--s-color-border-positive);
    color: var(--s-color-content-positive);
  }
  :global(.marker--negative .marker__disc) {
    background: var(--s-color-surface-negative-default);
    border-color: var(--s-color-border-negative);
    color: var(--s-color-content-negative);
  }
  :global(.marker--negative .marker__label) {
    background: var(--s-color-surface-negative-translucid);
    border-color: var(--s-color-border-negative);
    color: var(--s-color-content-negative);
  }
  :global(.marker--warning .marker__disc) {
    background: var(--s-color-surface-warning-default);
    border-color: var(--s-color-border-warning);
    color: var(--s-color-content-warning);
  }
  :global(.marker--warning .marker__label) {
    background: var(--s-color-surface-warning-translucid);
    border-color: var(--s-color-border-warning);
    color: var(--s-color-content-warning);
  }
  :global(.marker--unknown .marker__disc) {
    background: var(--s-color-surface-unknown-default);
    border-color: var(--s-color-border-unknown);
    color: var(--s-color-content-unknown);
  }
  :global(.marker--unknown .marker__label) {
    background: var(--s-color-surface-unknown-translucid);
