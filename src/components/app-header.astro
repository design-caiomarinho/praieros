---
import ButtonIcon from './button-icon.astro';
import logo from '../assets/logo.svg';

// Cabeçalho do app (Figma, nó 126:4735 da tela Início / Desktop).
// Ordem: compartilhar, informações, busca (busca em destaque).
interface Props {
  homeHref?: string;
  /** Destino de "Informações" (Fonte e como ler). */
  infoHref?: string;
  /** Id do painel de busca que o botão de busca abre (aria-controls). */
  searchId?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { homeHref = `${base}/`, infoHref = '#fonte', searchId } = Astro.props;
---

<header class="header">
  <a class="logo" href={homeHref}>
    <img
      src={logo.src}
      alt="Praieros, página inicial"
      width="103"
      height="20"
    />
  </a>
  <div class="actions">
    <ButtonIcon
      variant="ghost"
      icon="share"
      label="Compartilhar o site"
      disabled
    />
    <ButtonIcon
      variant="ghost"
      icon="info"
      label="Fonte e como ler"
      href={infoHref}
    />
    <ButtonIcon
      variant="filled"
      icon="search"
      label="Buscar praia"
      reveal="Busca"
      revealEngaged="Buscar"
      controls={searchId}
    />
  </div>
</header>

<style>
  .header {
    position: relative;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-left: var(--space-inset-lg);
    background: var(--s-color-surface-default);
    border-bottom: var(--border-width-default) solid
      var(--s-color-border-default);
  }
  /* Linha de baixo inteira, também com a busca aberta (Figma 213:3706: o painel não se junta ao
     botão). Desenhada por ::after (a borda fica transparente) para a Fonte poder abrir vão. */
  .header:not([data-source-open]) {
    border-bottom-color: transparent;
  }
  .header:not([data-source-open])::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    /* Sobre a linha da borda (que fica fora da caixa de padding), não 1px acima. */
    bottom: calc(var(--border-width-default) * -1);
    height: var(--border-width-default);
    background: var(--s-color-border-default);
  }
  /* Fonte e como ler aberta (`data-source-open`, ligado em index.astro): o botão de informação
     se junta ao painel, sem a linha de baixo. A linha continua à esquerda e sob a busca. */
  .header[data-source-open] {
    border-bottom-color: transparent;
  }
  .header[data-source-open]::before,
  .header[data-source-open]::after {
    content: '';
    position: absolute;
    bottom: calc(var(--border-width-default) * -1);
    height: var(--border-width-default);
    background: var(--s-color-border-default);
  }
  .header[data-source-open]::before {
    left: 0;
    right: calc((var(--space-inset-sm) * 2 + var(--primitives-spacing-24)) * 2);
  }
  .header[data-source-open]::after {
    right: 0;
    width: calc(var(--space-inset-sm) * 2 + var(--primitives-spacing-24));
  }
  /* Mobile: a folha sobe de baixo, longe do botão; então a linha de baixo do cabeçalho não
     encolhe nem abre vão sob o botão (busca ou Fonte). Só o botão muda de estado. */
  @media (max-width: 1023.98px) {
    .header[data-source-open] {
      border-bottom-color: var(--s-color-border-default);
    }
    .header[data-source-open]::before,
    .header[data-source-open]::after,
    .header:not([data-source-open])::before {
      display: none;
    }
    .header:not([data-source-open]):has([aria-expanded='true'])::after {
      clip-path: inset(0);
    }
  }
  /* Mobile (abaixo do breakpoint de 1024px da página): inset md (16px). */
  @media (max-width: 1023px) {
    .header {
      padding-left: var(--space-inset-md);
    }
  }
  .logo {
    display: inline-flex;
    align-items: center;
  }
  .logo img {
    display: block;
  }
  .actions {
    display: flex;
    align-items: stretch;
  }
  /* Divisor de 1px antes de cada botão (como no Figma). */
  .actions > :global(*) {
    border-left: var(--border-width-default) solid var(--s-color-border-default);
  }
</style>
