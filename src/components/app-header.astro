---
import ButtonIcon from './button-icon.astro';
import logo from '../assets/logo.svg';

// Cabeçalho do app (Figma, nó 126:4735 da tela Início / Desktop).
// Ordem: compartilhar, informações, busca (busca em destaque).
interface Props {
  homeHref?: string;
  /** Destino de "Informações" (Fonte dos dados). */
  infoHref?: string;
  /** Id do painel de busca que o botão de busca abre (aria-controls). */
  searchId?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { homeHref = `${base}/`, infoHref = '#fonte', searchId } = Astro.props;
---

<header class="header">
  <a class="logo" href={homeHref}>
    <img
      src={logo.src}
      alt="Praieros, página inicial"
      width="103"
      height="20"
    />
  </a>
  <div class="actions">
    <ButtonIcon
      variant="ghost"
      icon="share"
      label="Compartilhar o site"
      reveal="Compartilhar"
      revealEngaged="Compartilhar"
      controls="share-site-slot"
    />
    <ButtonIcon
      variant="ghost"
      icon="info"
      label="Fonte dos dados"
      reveal="Fonte"
      revealEngaged="Fonte"
      href={infoHref}
    />
    <ButtonIcon
      variant="filled"
      icon="search"
      label="Buscar praia"
      reveal="Buscar"
      revealEngaged="Buscar"
      controls={searchId}
    />
  </div>
</header>

<style>
  .header {
    position: relative;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-left: var(--space-inset-md);
    background: var(--s-color-surface-default);
    border-bottom: var(--border-width-default) solid
      var(--s-color-border-default);
  }
  /* Desktop: com o painel da Fonte ou do Compartilhar aberto, o botão (já "desabilitado", com o texto
     visível) se junta ao painel: cobre a linha de baixo do cabeçalho só na largura dele, que cresce
     com o texto. A busca aberta mantém a linha inteira (Figma 213:3706). No mobile a folha sobe de
     baixo, longe do botão: a linha não muda. */
  @media (min-width: 1024px) {
    .actions :global(.btn-icon--ghost[data-engaged]) {
      position: relative;
    }
    .actions :global(.btn-icon--ghost[data-engaged])::after {
      content: '';
      position: absolute;
      left: calc(var(--border-width-default) * -1);
      right: 0;
      bottom: calc(var(--border-width-default) * -1);
      height: var(--border-width-default);
      background: var(--s-color-surface-default);
    }
  }
  .logo {
    display: inline-flex;
    align-items: center;
  }
  .logo img {
    display: block;
  }
  .actions {
    display: flex;
    align-items: stretch;
  }
  /* Divisor de 1px antes de cada botão (como no Figma). */
  .actions > :global(*) {
    border-left: var(--border-width-default) solid var(--s-color-border-default);
  }
</style>
