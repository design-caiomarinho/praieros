---
import Button from './button.astro';
import ButtonIcon from './button-icon.astro';

// Painel Compartilhar site (Figma 126:8129, desktop): o do compartilhar praia sem a prévia do
// mapa. Aberto pelo botão de compartilhar do cabeçalho. Só apresentação: o link e a mensagem vêm
// prontos (ver `src/lib/share/share.ts`); fechar e copiar são ligados em index.astro.
interface Props {
  /** Link da raiz do site. */
  url: string;
  /** Link `wa.me` com a mensagem já montada. */
  whatsappHref: string;
}

const { url, whatsappHref } = Astro.props;
---

<section
  class="panel"
  aria-label="Compartilhar site"
  tabindex="-1"
  data-share-url={url}
>
  <header class="head">
    <div class="top">
      <h2>Compartilhar site</h2>
      <div class="close" data-share-site-close>
        <ButtonIcon
          variant="ghost"
          size="xsmall"
          icon="close"
          label="Fechar compartilhamento"
        />
      </div>
    </div>
  </header>

  <div class="scroll" data-scroll>
    <div class="body">
      <p class="intro">
        O Praieros é um site independente que mostra o boletim do Inema de forma
        mais clara. Compartilhe para ajudar mais pessoas a se informarem antes
        de ir à praia.
      </p>
      <div class="actions">
        <div class="whatsapp">
          <Button variant="primary" href={whatsappHref} target="_blank">
            Compartilhar via WhatsApp
          </Button>
        </div>
        <div class="copy" data-share-copy>
          <ButtonIcon
            variant="outlined"
            icon="copy"
            swapIcon="check"
            label="Copiar link"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    width: var(--size-panel-width);
    max-width: 100%;
    background: var(--s-color-surface-default);
    color: var(--s-color-content-primary);
    border-left: var(--border-width-default) solid var(--s-color-border-default);
  }
  .panel:focus {
    outline: none;
  }
  .head {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    padding: var(--space-inset-sm) var(--space-inset-lg);
    border-bottom: var(--border-width-default) solid
      var(--s-color-border-default);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-gap-md);
  }
  .close {
    display: contents;
  }
  h2 {
    margin: 0;
    color: var(--s-color-content-primary);
    font-family: var(--s-typo-heading-medium-family);
    font-weight: var(--s-typo-heading-medium-weight);
    font-size: var(--s-typo-heading-medium-size);
    line-height: var(--s-typo-heading-medium-line);
    letter-spacing: var(--s-typo-heading-medium-spacing);
  }
  .scroll {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
    overflow-y: auto;
  }
  /* Corpo (Figma 249:5574): padding 24, texto e botões separados por 32. */
  .body {
    display: flex;
    flex: 1 0 auto;
    flex-direction: column;
    gap: var(--space-stack-xl);
    padding: var(--space-inset-lg);
  }
  .intro {
    margin: 0;
    color: var(--s-color-content-secondary);
    font-family: var(--s-typo-body-medium-family);
    font-weight: var(--s-typo-body-medium-weight);
    font-size: var(--s-typo-body-medium-size);
    line-height: var(--s-typo-body-medium-line);
    letter-spacing: var(--s-typo-body-medium-spacing);
  }
  .actions {
    display: flex;
    gap: var(--space-stack-xs);
  }
  .whatsapp {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
  }
  .whatsapp > :global(*) {
    flex: 1 1 auto;
    justify-content: center;
  }
  .copy {
    display: contents;
  }
  /* Mobile, folha inferior (mesmo padrão do compartilhar praia). */
  @media (max-width: 1023px) {
    .panel {
      width: auto;
      border-left: 0;
      border-top: var(--border-width-default) solid
        var(--s-color-border-default);
    }
    .head {
      padding: var(--space-inset-sm) var(--space-inset-md);
    }
    .body {
      padding: var(--space-inset-lg) var(--space-inset-md)
        calc(var(--space-inset-lg) + env(safe-area-inset-bottom, 0px));
    }
    .close :global(.btn-icon) {
      position: relative;
    }
    .close :global(.btn-icon)::after {
      content: '';
      position: absolute;
      inset: calc(var(--primitives-spacing-4) / -2);
    }
  }
</style>
