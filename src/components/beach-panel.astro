---
import PointCard from './point-card.astro';
import Button from './button.astro';
import ButtonIcon from './button-icon.astro';
import Icon from './icon.astro';
import { RAIN_NOTICE_TEXT } from '../lib/site/rain-notice.ts';
import { pointsLabel } from '../lib/format/points-label.ts';
import type { ChipStatus } from '../lib/rules/status.ts';

// Painel da ficha da praia: só estrutura e apresentação. Recebe tudo pronto por props,
// sem ler dados nem aplicar regras de negócio (R1–R4 ficam fora daqui).
export interface PanelPoint {
  /** Id do marcador do ponto no mapa (liga cartão e pin). */
  id?: string;
  name: string;
  location?: string;
  status: ChipStatus;
  /** Posição automática no mapa: mostra "Posição aproximada". */
  accuracy?: 'approximate' | 'very-approximate' | null;
}

interface Props {
  name: string;
  neighborhood?: string;
  /** Boletim exibido na ficha (o atual, ou o último em que a praia apareceu). */
  bulletin: { number: string; date: string; pdfUrl: string };
  points: PanelPoint[];
  /** Faixa de topo: 'outdated' (Boletim desatualizado) ou 'no-result' (Sem resultado). */
  notice?: 'outdated' | 'no-result';
  /** Frase já pronta sob o chip do boletim (ex.: "Esta praia não consta no boletim nº 37/2026."). */
  note?: string;
  /** Mostra o aviso de chuva (decidido por `shouldShowRainNotice`). */
  rainNotice?: boolean;
  /** Nº de pontos de coleta da praia para o subtítulo (padrão: `points.length`). */
  pointCount?: number;
  layout?: 'desktop' | 'mobile';
  /** Mostra "Ver detalhes", que abre a Classificação (desktop e mobile; ligado em index.astro). */
  showDetails?: boolean;
  sourceHref?: string;
}

const {
  name,
  neighborhood,
  bulletin,
  points,
  notice,
  note,
  rainNotice = false,
  pointCount = points.length,
  layout = 'desktop',
  showDetails = false,
  sourceHref = '#fonte',
} = Astro.props;

// Sem ponto de coleta (informação desconhecida) mostra "Sem ponto de coleta", como na busca.
const subtitle = [neighborhood, pointsLabel(pointCount)]
  .filter(Boolean)
  .join(' · ');
// Figma 125:3674: sem resultado, a ficha mostra o estado vazio no lugar dos pontos e das ações.
const noResult = notice === 'no-result';
---

<section
  class={`panel panel--${layout}`}
  aria-label={`Ficha: ${name}`}
  tabindex="-1"
>
  {/* A faixa de aviso fica no topo do mapa (index.astro), fora do painel, no desktop e no mobile. */}
  {/* Cabeçalho só com o título "Detalhes", como o da busca (Figma 217:6800). */}
  <header class="head">
    <div class="top">
      <div class="title">
        {/* Só aparece quando a ficha foi aberta pela busca (index.astro). */}
        <div class="back" data-panel-back hidden>
          <ButtonIcon
            variant="ghost"
            size="xsmall"
            icon="arrow-left"
            label="Voltar à busca"
          />
        </div>
        <h2>Detalhes</h2>
      </div>
      <div class="close" data-panel-close>
        <ButtonIcon
          variant="ghost"
          size="xsmall"
          icon="close"
          label="Fechar ficha da praia"
        />
      </div>
    </div>
  </header>

  <div class="body">
    <div class="main">
      <div class="intro">
        <div class="titles">
          <h3 class="beach-name">{name}</h3>
          <p class="subtitle">{subtitle}</p>
        </div>
        <div class="bulletin">
          <span class="bulletin-chip">
            {noResult
              ? 'Boletim não encontrado'
              : `Boletim nº ${bulletin.number} · emitido em ${bulletin.date}`}
          </span>
          {note && <p class="note">{note}</p>}
        </div>
      </div>
      {noResult && (
        <div class="empty">
          <div class="empty-icon">
            <Icon name="warning" size={24} />
          </div>
          <div class="empty-text">
            <p class="empty-title">Sem resultado</p>
            <p class="empty-body">
              Não há resultado do Inema
              <br />
              para esta praia.
            </p>
          </div>
        </div>
      )}
      {!noResult && points.length > 0 && (
        <div class="points">
          <h4>Pontos de coleta</h4>
          <div class="cards">
            {points.map((p) => (
              <PointCard
                pointId={p.id}
                name={p.name}
                location={p.location}
                status={p.status}
                accuracy={p.accuracy}
              />
            ))}
            {rainNotice && (
              <div class="rain">
                <Icon name="rain" size={20} />
                <p>{RAIN_NOTICE_TEXT}</p>
              </div>
            )}
          </div>
        </div>
      )}

      {!noResult && (
        <div class="buttons">
          {showDetails && (
            <div class="details" data-open-classification>
              <Button variant="primary">Ver detalhes</Button>
            </div>
          )}
          <ButtonIcon
            variant="outlined"
            icon="share"
            label="Compartilhar praia"
            disabled
          />
        </div>
      )}
    </div>
  </div>

  <footer class="foot-wrap">
    <div class="foot">
      <div class="links">
        <Button
          variant="secondary"
          href={sourceHref}
          spread
          iconRight="chevron-right"
        >
          Como ler e fonte
        </Button>
        <Button
          variant="secondary"
          href={bulletin.pdfUrl}
          target="_blank"
          spread
          iconRight="external"
        >
          Boletim original
        </Button>
      </div>
      <p class="credit">Fonte: Inema · Praieros não é canal oficial</p>
    </div>
  </footer>
</section>

<style>
  .panel {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--s-color-surface-default);
    color: var(--s-color-content-primary);
  }
  /* Desktop: painel lateral. Mobile: folha inferior (sem raio, não há token). */
  /* Recebe o foco ao abrir (sem anel: não é um controle). */
  .panel:focus {
    outline: none;
  }
  .panel--desktop {
    width: var(--size-panel-width);
    max-width: 100%;
    border-left: var(--border-width-default) solid var(--s-color-border-default);
  }
  .panel--mobile {
    border-top: var(--border-width-default) solid var(--s-color-border-default);
  }
  /* Cabeçalho (Figma 217:6822): só o título, padding 16 vertical e 24 lateral, borda inferior. */
  .head {
    display: flex;
    flex-direction: column;
    padding: var(--space-inset-md) var(--space-inset-lg);
    border-bottom: var(--border-width-default) solid
      var(--s-color-border-default);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-md);
  }
  .titles {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-xs);
  }
  .beach-name {
    margin: 0;
    color: var(--s-color-content-primary);
    font-family: var(--s-typo-heading-large-family);
    font-weight: var(--s-typo-heading-large-weight);
    font-size: var(--s-typo-heading-large-size);
    line-height: var(--s-typo-heading-large-line);
    letter-spacing: var(--s-typo-heading-large-spacing);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-gap-md);
  }
  .close,
  .back {
    display: contents;
  }
  .back[hidden] {
    display: none;
  }
  .title {
    display: flex;
    align-items: center;
    gap: var(--space-gap-xs);
    min-width: 0;
  }
  h2 {
    margin: 0;
    color: var(--s-color-content-primary);
    font-family: var(--s-typo-heading-large-family);
    font-weight: var(--s-typo-heading-large-weight);
    font-size: var(--s-typo-heading-large-size);
    line-height: var(--s-typo-heading-large-line);
    letter-spacing: var(--s-typo-heading-large-spacing);
  }
  .subtitle,
  .note {
    margin: 0;
    color: var(--s-color-content-secondary);
    font-family: var(--s-typo-body-medium-family);
    font-weight: var(--s-typo-body-medium-weight);
    font-size: var(--s-typo-body-medium-size);
    line-height: var(--s-typo-body-medium-line);
    letter-spacing: var(--s-typo-body-medium-spacing);
  }
  .bulletin {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-stack-sm);
  }
  .bulletin-chip {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    height: var(--primitives-spacing-24);
    padding: var(--space-inset-2xs) var(--space-inset-xs);
    border: var(--border-width-default) solid var(--s-color-border-default);
    border-radius: var(--radius-full);
    background: var(--s-color-surface-strong);
    color: var(--s-color-content-secondary);
    font-family: var(--s-typo-body-small-family);
    font-weight: var(--s-typo-body-small-weight);
    font-size: var(--s-typo-body-small-size);
    line-height: var(--s-typo-body-small-line);
    letter-spacing: var(--s-typo-body-small-spacing);
    white-space: nowrap;
  }
  /* Corpo (Figma 217:6826): padding 24; título, pontos e ações. */
  .body {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    padding: var(--space-inset-lg);
  }
  .main,
  .foot {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-md);
  }
  .main {
    gap: var(--space-stack-xl);
  }
  /* Rodapé (Figma 217:6997): borda no topo, padding 24, links e crédito. */
  .foot-wrap {
    padding: var(--space-inset-lg);
    border-top: var(--border-width-default) solid var(--s-color-border-default);
  }
  /* Estado vazio (Figma 173:2510): centralizado no espaço entre o cabeçalho e os links. */
  .main:has(.empty) {
    flex: 1;
  }
  .empty {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-gap-xl);
  }
  .empty-icon {
    display: flex;
    padding: var(--space-inset-sm);
    background: var(--s-color-surface-accent-subtle);
    color: var(--s-color-content-accent);
  }
  .empty-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-gap-md);
    width: 230px;
    text-align: center;
  }
  .empty-title,
  .empty-body {
    margin: 0;
  }
  .empty-title {
    color: var(--s-color-content-primary);
    font-family: var(--s-typo-heading-large-family);
    font-weight: var(--s-typo-heading-large-weight);
    font-size: var(--s-typo-heading-large-size);
    line-height: var(--s-typo-heading-large-line);
    letter-spacing: var(--s-typo-heading-large-spacing);
  }
  .empty-body {
    color: var(--s-color-content-secondary);
    font-family: var(--s-typo-body-medium-family);
    font-weight: var(--s-typo-body-medium-weight);
    font-size: var(--s-typo-body-medium-size);
    line-height: var(--s-typo-body-medium-line);
    letter-spacing: var(--s-typo-body-medium-spacing);
  }
  .points {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-md);
  }
  h4 {
    margin: 0;
    color: var(--s-color-content-muted);
    font-family: var(--s-typo-body-small-family);
    font-weight: var(--s-typo-body-small-weight);
    font-size: var(--s-typo-body-small-size);
    line-height: var(--s-typo-body-small-line);
    letter-spacing: var(--s-typo-body-small-spacing);
  }
  .cards,
  .links {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-xs);
  }
  /* "Ver detalhes" ocupa o que sobra; compartilhar é o botão de ícone ao lado (Figma 217:6966). */
  .links {
    flex-direction: row;
  }
  .links > :global(*) {
    flex: 1 1 0;
    min-width: 0;
  }
  .buttons {
    display: flex;
    gap: var(--space-stack-xs);
  }
  .buttons > :global(*) {
    justify-content: center;
  }
  .details {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    min-width: 0;
  }
  .details > :global(*) {
    justify-content: center;
  }
  /* Aviso de chuva (Figma 123:2643). */
  .rain {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: var(--space-gap-md);
    padding: var(--space-inset-md);
    border: var(--border-width-default) solid var(--s-color-border-default);
    background: var(--s-color-surface-strong);
    color: var(--s-color-content-secondary);
  }
  .rain p {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-family: var(--s-typo-body-medium-family);
    font-weight: var(--s-typo-body-medium-weight);
    font-size: var(--s-typo-body-medium-size);
    line-height: var(--s-typo-body-medium-line);
    letter-spacing: var(--s-typo-body-medium-spacing);
  }
  /* Mobile, folha inferior (Figma 125:3471): padding 16 lateral e 24 vertical no cabeçalho e no
     corpo; 16 entre título + subtítulo e o chip; alvo de toque do fechar de 44px. */
  /* No mobile os dois links empilham, cada um na largura toda. */
  .panel--mobile .links {
    flex-direction: column;
  }
  .panel--mobile .head {
    padding: var(--space-inset-md);
  }
  .panel--mobile .body {
    padding: var(--space-inset-lg) var(--space-inset-md);
  }
  .panel--mobile .foot-wrap {
    padding: var(--space-inset-lg) var(--space-inset-md);
    padding-bottom: calc(
      var(--space-inset-lg) + env(safe-area-inset-bottom, 0px)
    );
  }
  .panel--mobile .close :global(.btn-icon) {
    position: relative;
  }
  .panel--mobile .close :global(.btn-icon)::after {
    content: '';
    position: absolute;
    inset: calc(var(--primitives-spacing-4) / -2);
  }
  .credit {
    margin: 0;
    color: var(--s-color-content-muted);
    font-family: var(--s-typo-caption-small-family);
    font-weight: var(--s-typo-caption-small-weight);
    font-size: var(--s-typo-caption-small-size);
    line-height: var(--s-typo-caption-small-line);
    letter-spacing: var(--s-typo-caption-small-spacing);
  }
</style>
