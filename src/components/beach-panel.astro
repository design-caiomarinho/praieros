---
import PointCard from './point-card.astro';
import OutdatedBanner from './outdated-banner.astro';
import NoResultBanner from './no-result-banner.astro';
import Button from './button.astro';
import ButtonIcon from './button-icon.astro';
import Icon from './icon.astro';
import { RAIN_NOTICE_TEXT } from '../lib/site/rain-notice.ts';
import { pointsLabel } from '../lib/format/points-label.ts';
import type { ChipStatus } from '../lib/rules/status.ts';

// Painel da ficha da praia: só estrutura e apresentação. Recebe tudo pronto por props,
// sem ler dados nem aplicar regras de negócio (R1–R4 ficam fora daqui).
export interface PanelPoint {
  /** Id do marcador do ponto no mapa (liga cartão e pin). */
  id?: string;
  name: string;
  location?: string;
  status: ChipStatus;
  /** Posição automática no mapa: mostra "Posição aproximada". */
  accuracy?: 'approximate' | 'very-approximate' | null;
}

interface Props {
  name: string;
  neighborhood?: string;
  /** Boletim exibido na ficha (o atual, ou o último em que a praia apareceu). */
  bulletin: { number: string; date: string; pdfUrl: string };
  points: PanelPoint[];
  /** Faixa de topo: 'outdated' (Boletim desatualizado) ou 'no-result' (Sem resultado). */
  notice?: 'outdated' | 'no-result';
  /** Frase já pronta sob o chip do boletim (ex.: "Esta praia não consta no boletim nº 37/2026."). */
  note?: string;
  /** Mostra o aviso de chuva (decidido por `shouldShowRainNotice`). */
  rainNotice?: boolean;
  layout?: 'desktop' | 'mobile';
  detailsHref?: string;
  sourceHref?: string;
}

const {
  name,
  neighborhood,
  bulletin,
  points,
  notice,
  note,
  rainNotice = false,
  layout = 'desktop',
  detailsHref = '#',
  sourceHref = '/fonte',
} = Astro.props;

const subtitle = [
  neighborhood,
  points.length > 0 ? pointsLabel(points.length) : null,
]
  .filter(Boolean)
  .join(' · ');
---

<section
  class={`panel panel--${layout}`}
  aria-label={`Ficha: ${name}`}
  tabindex="-1"
>
  {/* Desktop: a faixa fica no topo do mapa (index.astro), fora do painel. */}
  {layout === 'mobile' && notice === 'outdated' && <OutdatedBanner />}
  {layout === 'mobile' && notice === 'no-result' && <NoResultBanner />}
  <header class="head">
    <div class="titles">
      <div class="top">
        <h2>{name}</h2>
        <div class="close" data-panel-close>
          <ButtonIcon
            variant="ghost"
            size="xsmall"
            icon="close"
            label="Fechar ficha da praia"
          />
        </div>
      </div>
      <p class="subtitle">{subtitle}</p>
    </div>
    <div class="bulletin">
      <span class="bulletin-chip">
        Boletim nº {bulletin.number} · emitido em {bulletin.date}
      </span>
      {note && <p class="note">{note}</p>}
    </div>
  </header>

  <div class="body">
    <div class="main">
      {points.length > 0 && (
        <div class="points">
          <h3>Pontos de coleta</h3>
          <div class="cards">
            {points.map((p) => (
              <PointCard
                pointId={p.id}
                name={p.name}
                location={p.location}
                status={p.status}
                accuracy={p.accuracy}
              />
            ))}
            {rainNotice && (
              <div class="rain">
                <Icon name="rain" size={20} />
                <p>{RAIN_NOTICE_TEXT}</p>
              </div>
            )}
          </div>
        </div>
      )}

      <div class="buttons">
        <Button variant="primary" href={detailsHref}>
          Ver detalhes
        </Button>
        <Button variant="secondary">Compartilhar praia</Button>
      </div>
    </div>

    <div class="foot">
      <div class="links">
        <Button
          variant="secondary"
          href={sourceHref}
          spread
          iconRight="chevron-right"
        >
          Como ler e fonte
        </Button>
        <Button
          variant="secondary"
          href={bulletin.pdfUrl}
          target="_blank"
          spread
          iconRight="external"
        >
          Boletim original
        </Button>
      </div>
      <p class="credit">Fonte: Inema · Praieros não é canal oficial</p>
    </div>
  </div>
</section>

<style>
  .panel {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--s-color-surface-default);
    color: var(--s-color-content-primary);
  }
  /* Desktop: painel lateral. Mobile: folha inferior (sem raio, não há token). */
  /* Recebe o foco ao abrir (sem anel: não é um controle). */
  .panel:focus {
    outline: none;
  }
  .panel--desktop {
    width: var(--size-panel-width);
    max-width: 100%;
    border-left: var(--border-width-default) solid var(--s-color-border-default);
  }
  .panel--mobile {
    border-top: var(--border-width-default) solid var(--s-color-border-default);
  }
  /* Cabeçalho (Figma 123:2441): padding 24, borda inferior. */
  .head {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-sm);
    padding: var(--space-inset-lg);
    border-bottom: var(--border-width-default) solid
      var(--s-color-border-default);
  }
  .titles {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-2xs);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-gap-md);
  }
  .close {
    display: contents;
  }
  h2 {
    margin: 0;
    color: var(--s-color-content-primary);
    font-family: var(--s-typo-heading-large-family);
    font-weight: var(--s-typo-heading-large-weight);
    font-size: var(--s-typo-heading-large-size);
    line-height: var(--s-typo-heading-large-line);
    letter-spacing: var(--s-typo-heading-large-spacing);
  }
  .subtitle,
  .note {
    margin: 0;
    color: var(--s-color-content-secondary);
    font-family: var(--s-typo-body-medium-family);
    font-weight: var(--s-typo-body-medium-weight);
    font-size: var(--s-typo-body-medium-size);
    line-height: var(--s-typo-body-medium-line);
    letter-spacing: var(--s-typo-body-medium-spacing);
  }
  .bulletin {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-stack-sm);
  }
  .bulletin-chip {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    height: var(--primitives-spacing-24);
    padding: var(--space-inset-2xs) var(--space-inset-xs);
    border: var(--border-width-default) solid var(--s-color-border-default);
    border-radius: var(--radius-full);
    background: var(--s-color-surface-strong);
    color: var(--s-color-content-secondary);
    font-family: var(--s-typo-body-small-family);
    font-weight: var(--s-typo-body-small-weight);
    font-size: var(--s-typo-body-small-size);
    line-height: var(--s-typo-body-small-line);
    letter-spacing: var(--s-typo-body-small-spacing);
    white-space: nowrap;
  }
  /* Corpo (Figma 123:2456): padding 24; ações no topo, links e crédito no rodapé. */
  .body {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-stack-xl);
    padding: var(--space-inset-lg);
  }
  .main,
  .foot {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-md);
  }
  .points {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-md);
  }
  h3 {
    margin: 0;
    color: var(--s-color-content-muted);
    font-family: var(--s-typo-body-small-family);
    font-weight: var(--s-typo-body-small-weight);
    font-size: var(--s-typo-body-small-size);
    line-height: var(--s-typo-body-small-line);
    letter-spacing: var(--s-typo-body-small-spacing);
  }
  .cards,
  .buttons,
  .links {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-xs);
  }
  .buttons > :global(*) {
    justify-content: center;
  }
  /* Aviso de chuva (Figma 123:2643). */
  .rain {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: var(--space-gap-md);
    padding: var(--space-inset-md);
    border: var(--border-width-default) solid var(--s-color-border-default);
    background: var(--s-color-surface-strong);
    color: var(--s-color-content-secondary);
  }
  .rain p {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-family: var(--s-typo-body-medium-family);
    font-weight: var(--s-typo-body-medium-weight);
    font-size: var(--s-typo-body-medium-size);
    line-height: var(--s-typo-body-medium-line);
    letter-spacing: var(--s-typo-body-medium-spacing);
  }
  .credit {
    margin: 0;
    color: var(--s-color-content-muted);
    font-family: var(--s-typo-caption-small-family);
    font-weight: var(--s-typo-caption-small-weight);
    font-size: var(--s-typo-caption-small-size);
    line-height: var(--s-typo-caption-small-line);
    letter-spacing: var(--s-typo-caption-small-spacing);
  }
</style>
