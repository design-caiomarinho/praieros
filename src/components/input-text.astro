---
import Icon from './icon.astro';

interface Props {
  /** Nome acessível do campo (aria-label): obrigatório, o Figma não tem rótulo visível. */
  label: string;
  name?: string;
  id?: string;
  value?: string;
  placeholder?: string;
  disabled?: boolean;
  showIcon?: boolean;
  /** Só para a vitrine (/dev/components): força o visual de hover/foco/digitando. */
  state?: 'hover' | 'focus' | 'typing';
}

const {
  label,
  name,
  id,
  value,
  placeholder = 'Buscar praia',
  disabled = false,
  showIcon = true,
  state,
} = Astro.props;
---

<label
  class="field"
  data-state={state}
  data-disabled={disabled ? '' : undefined}
>
  {showIcon && <Icon name="search" size={24} />}
  <input
    class="field__input"
    type="search"
    id={id}
    name={name}
    value={value}
    placeholder={placeholder}
    disabled={disabled}
    aria-label={label}
    autocomplete="off"
  />
</label>

<style>
  .field {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: var(--space-gap-xs);
    width: 100%;
    /* 48 = 2 x inset/sm + 24, sem token próprio. */
    height: calc(var(--space-inset-sm) * 2 + var(--primitives-spacing-24));
    padding: var(--space-inset-xs) var(--space-inset-md);
    border: var(--border-width-default) solid var(--s-color-border-default);
    background: var(--s-color-surface-default);
    color: var(--s-color-content-secondary);
    cursor: text;
  }
  .field__input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    appearance: none;
    color: var(--s-color-content-primary);
    font-family: var(--s-typo-body-medium-family);
    font-weight: var(--s-typo-body-medium-weight);
    font-size: var(--s-typo-body-medium-size);
    line-height: var(--s-typo-body-medium-line);
    letter-spacing: var(--s-typo-body-medium-spacing);
  }
  .field__input::placeholder {
    color: var(--s-color-content-muted);
    opacity: 1;
  }
  .field__input::-webkit-search-cancel-button {
    display: none;
  }

  /* hover e foco */
  .field:hover:not([data-disabled]),
  .field:focus-within,
  .field[data-state='hover'],
  .field[data-state='focus'] {
    background: var(--s-color-surface-hover);
    border-color: var(--s-color-border-accent);
  }
  /* digitando: fundo padrão, borda de destaque */
  .field:focus-within:has(.field__input:not(:placeholder-shown)),
  .field[data-state='typing'] {
    background: var(--s-color-surface-default);
    border-color: var(--s-color-border-accent);
  }
  /* anel de foco: só quando o foco chegou por Tab (data-ring, ver script) */
  .field[data-ring],
  .field[data-state='focus'] {
    outline: var(--border-width-default) solid var(--s-color-border-focus);
    outline-offset: calc(
      var(--primitives-spacing-4) - var(--border-width-default)
    );
  }

  .field[data-disabled] {
    background: var(--s-color-surface-disabled);
    border-color: var(--s-color-border-disabled);
    color: var(--s-color-content-disabled);
    cursor: not-allowed;
  }
  .field__input:disabled {
    color: var(--s-color-content-disabled);
    cursor: not-allowed;
  }
  .field__input:disabled::placeholder {
    color: var(--s-color-content-disabled);
  }
</style>

<script>
  // Em campo de texto o navegador mostra :focus-visible também no clique.
  // Aqui o anel de foco só aparece se o foco chegou por Tab; no clique, só as bordas.
  let viaTab = false;
  document.addEventListener(
    'keydown',
    (e) => {
      if (e.key === 'Tab') viaTab = true;
    },
    true,
  );
  document.addEventListener(
    'pointerdown',
    () => {
      viaTab = false;
      document
        .querySelectorAll('.field[data-ring]')
        .forEach((f) => f.removeAttribute('data-ring'));
    },
    true,
  );
  document.addEventListener(
    'focusin',
    (e) => {
      const field = (e.target as HTMLElement).closest('.field');
      if (field && viaTab) field.setAttribute('data-ring', '');
    },
    true,
  );
  document.addEventListener(
    'focusout',
    (e) => {
      (e.target as HTMLElement).closest('.field')?.removeAttribute('data-ring');
    },
    true,
  );
</script>
