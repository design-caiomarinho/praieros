---
import Button from './button.astro';
import ButtonIcon from './button-icon.astro';
import Icon from './icon.astro';
import InputText from './input-text.astro';
import { pointsLabel } from '../lib/format/points-label.ts';
import { STATUS_LABELS } from '../lib/rules/status.ts';
import { abbreviateLabel } from '../lib/search/abbreviate.ts';
import {
  suggestNeighborhoods,
  type SearchResult,
} from '../lib/search/search.ts';

// Painel de busca (Figma 117:5075 e 117:6342, Praias encontradas / Desktop). Só apresentação:
// recebe as praias prontas (R1–R4 e D1 já aplicadas) e filtra no navegador com `lib/search`.
// Cada praia vira um item escondido, mostrado e reordenado conforme o texto.
// "Sem resultado de busca" é derivado (sem frame no Figma).
interface Props {
  id?: string;
  results: SearchResult[];
  /** Boletim atual (chip do cabeçalho). */
  bulletin: { number: string; date: string } | null;
  /** Estrutura pronta para a folha inferior (mobile); por ora só desktop. */
  layout?: 'desktop' | 'mobile';
}

const { id = 'search', results, bulletin, layout = 'desktop' } = Astro.props;
const neighborhoods = suggestNeighborhoods(results);
---

<section
  id={id}
  class={`search search--${layout}`}
  aria-label="Buscar praia"
  tabindex="-1"
  data-scroll-fade
  hidden
>
  <header class="head">
    <div class="head-top">
      <div class="top">
        <div class="title">
          <div class="back" data-search-back hidden>
            <ButtonIcon
              variant="ghost"
              size="xsmall"
              icon="arrow-left"
              label="Voltar"
            />
          </div>
          <h2 data-title>Buscar</h2>
          <span class="sk sk--title" aria-hidden="true"></span>
        </div>
        <div class="close" data-search-close>
          <ButtonIcon
            variant="ghost"
            size="xsmall"
            icon="close"
            label="Fechar busca"
          />
        </div>
      </div>
      {bulletin && (
        <span class="bulletin-chip">
          Boletim nº {bulletin.number} · emitido em {bulletin.date}
        </span>
      )}
    </div>
    <div class="field" data-field>
      <InputText label="Buscar praia" name="q" />
    </div>
    <span class="sk sk--field" aria-hidden="true"></span>
  </header>

  <div class="body">
    <!-- Esqueleto (Figma de Caio): só enquanto o mapa carrega; sem animação por enquanto. -->
    <div class="sk-body" aria-hidden="true">
      <span class="sk sk--label"></span>
      <div class="sk-grid">
        <span class="sk sk--hood"></span>
        <span class="sk sk--hood"></span>
        <span class="sk sk--hood"></span>
        <span class="sk sk--hood"></span>
        <span class="sk sk--hood"></span>
        <span class="sk sk--hood"></span>
        <span class="sk sk--hood"></span>
      </div>
    </div>
    <div class="found" data-found hidden>
      <p class="count" aria-hidden="true">
        <strong data-count-n></strong>
        <span data-count-rest></span>
      </p>
      <ul class="results" data-results aria-label="Resultados da busca">
        {results.map((r) => {
          // Praia sem ponto de coleta (informação desconhecida) mostra "Nenhum ponto de coleta", como
          // no concept da busca.
          const meta = [r.neighborhood, pointsLabel(r.pointCount)]
            .filter(Boolean)
            .join(' · ');
          return (
            <li
              data-result
              data-slug={r.slug}
              data-name={r.name}
              data-hood={r.neighborhood ?? ''}
              hidden
            >
              <button
                type="button"
                class="result"
                aria-disabled={r.selectable ? undefined : 'true'}
              >
                <span class="text">
                  <span class="name">{r.name}</span>
                  <span class="meta">
                    <span class={`dot dot--${r.status}`} aria-hidden="true" />
                    <span class="sr-only">{STATUS_LABELS[r.status]}</span>
                    <span class="sub">{meta}</span>
                  </span>
                  {r.outdated && <span class="sub">Boletim desatualizado</span>}
                </span>
                <Icon name="chevron-right" size={20} />
              </button>
            </li>
          );
        })}
      </ul>
    </div>

    <!-- Sem resultado de busca (Figma): mesmo desenho do erro do mapa. -->
    <div class="empty" data-empty hidden>
      <span class="empty-icon">
        <Icon name="warning" />
      </span>
      <div class="empty-content">
        <div class="empty-texts">
          <h3 class="empty-title">
            Não encontramos praias para “<span data-empty-q></span>”
          </h3>
          <p class="empty-body">
            Tente outro nome ou busque pelo bairro. Você também pode ver todas
            as praias.
          </p>
        </div>
        <div class="empty-action" data-search-retry>
          <Button variant="primary" size="small">
            Tente novamente
          </Button>
        </div>
      </div>
    </div>

    {neighborhoods.length > 0 && (
      <div class="hoods" data-hoods>
        <h3>Bairros</h3>
        <div class="hood-grid">
          {neighborhoods.map((hood) => (
            <div class="hood" data-hood={hood}>
              <Button variant="secondary" size="small" selected={false}>
                {abbreviateLabel(hood) === hood ? (
                  hood
                ) : (
                  <>
                    <span aria-hidden="true">{abbreviateLabel(hood)}</span>
                    <span class="sr-only">{hood}</span>
                  </>
                )}
              </Button>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

  <p class="sr-only" role="status" aria-live="polite" data-live></p>
</section>

<style>
  .search {
    position: relative;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    min-height: 0;
    width: 100%;
    /* O painel inteiro rola (cabeçalho e corpo), como Fonte e como ler. */
    overflow-y: auto;
    background: var(--s-color-surface-default);
    color: var(--s-color-content-primary);
  }
  .search[hidden],
  .search [hidden] {
    display: none;
  }
  /* Recebe o foco só como último recurso (sem anel: não é um controle). */
  .search:focus {
    outline: none;
  }
  /* Mobile: tela cheia sob a navbar (Figma 117:5257); o posicionamento vem da página. */
  .search {
    width: 100%;
  }
  @media (min-width: 1024px) {
    .search {
      width: var(--size-panel-width);
      max-width: 100%;
      border-left: var(--border-width-default) solid
        var(--s-color-border-default);
    }
  }

  /* Cabeçalho (Figma 117:5179): padding 24, 24 entre o bloco do título e o campo, borda inferior. */
  .head {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    gap: var(--space-stack-lg);
    padding: var(--space-inset-lg);
    border-bottom: var(--border-width-default) solid
      var(--s-color-border-default);
  }
  .head-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-stack-xs);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-gap-md);
    width: 100%;
  }
  .close,
  .back {
    display: contents;
  }
  /* Título (com a seta de voltar na vista de um bairro, como em Fonte e como ler). */
  .title {
    display: flex;
    align-items: center;
    gap: var(--space-gap-xs);
    min-width: 0;
  }
  h2 {
    margin: 0;
    color: var(--s-color-content-primary);
    font-family: var(--s-typo-heading-large-family);
    font-weight: var(--s-typo-heading-large-weight);
    font-size: var(--s-typo-heading-large-size);
    line-height: var(--s-typo-heading-large-line);
    letter-spacing: var(--s-typo-heading-large-spacing);
  }
  .bulletin-chip {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    height: var(--primitives-spacing-24);
    padding: var(--space-inset-2xs) var(--space-inset-xs);
    border: var(--border-width-default) solid var(--s-color-border-default);
    border-radius: var(--radius-full);
    background: var(--s-color-surface-strong);
    color: var(--s-color-content-secondary);
    font-family: var(--s-typo-body-small-family);
    font-weight: var(--s-typo-body-small-weight);
    font-size: var(--s-typo-body-small-size);
    line-height: var(--s-typo-body-small-line);
    letter-spacing: var(--s-typo-body-small-spacing);
    white-space: nowrap;
  }

  /* Corpo (Figma 117:6377): padding 24, 32 entre resultados e bairros. Ocupa o resto da altura
     (centra o "sem resultado"); quem rola é o painel todo. `position: relative` prende os
     textos só para leitor de tela (sr-only) aqui dentro, para não criarem rolagem na página. */
  .body {
    position: relative;
    display: flex;
    flex: 1 0 auto;
    flex-direction: column;
    gap: var(--space-stack-xl);
    padding: var(--space-inset-lg);
  }
  .hoods,
  .found {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-md);
  }
  h3,
  .count {
    margin: 0;
    color: var(--s-color-content-muted);
    font-family: var(--s-typo-body-small-family);
    font-weight: var(--s-typo-body-small-weight);
    font-size: var(--s-typo-body-small-size);
    line-height: var(--s-typo-body-small-line);
    letter-spacing: var(--s-typo-body-small-spacing);
  }
  .count strong {
    font-weight: var(--primitives-font-weight-600);
  }
  .hood-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-gap-xs);
  }
  .hood {
    display: flex;
  }
  .hood > :global(*) {
    flex: 1;
    min-width: 0;
  }

  /* Item de resultado (Figma 117:6444): nome, ponto de status + detalhe, seta. Sem componente
     no Figma; segue a lógica do catálogo: padrão, hover (só borda), foco (teclado), desabilitado. */
  .results {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .result {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: var(--space-gap-md);
    width: 100%;
    padding: var(--space-inset-md);
    border: var(--border-width-default) solid var(--s-color-border-default);
    background: var(--s-color-surface-default);
    color: var(--s-color-content-primary);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  /* Mesmo padrão do botão secundário (outlined), como os bairros: hover e foco trocam a
     superfície; foco (teclado) ganha o anel. */
  .result:hover:not([aria-disabled='true']),
  .result:focus-visible {
    background: var(--s-color-surface-hover);
  }
  .result:focus-visible {
    outline: var(--border-width-default) solid var(--s-color-border-focus);
    outline-offset: var(--primitives-spacing-4);
  }
  /* Desabilitado (sem marcador no mapa): igual ao botão secundário desabilitado. */
  .result[aria-disabled='true'] {
    background: transparent;
    border-color: var(--s-color-surface-hover);
    color: var(--s-color-content-disabled);
    cursor: not-allowed;
  }
  .text {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }
  .name {
    font-family: var(--s-typo-body-medium-family);
    font-weight: var(--primitives-font-weight-600);
    font-size: var(--s-typo-body-medium-size);
    line-height: var(--s-typo-body-medium-line);
    letter-spacing: var(--s-typo-body-medium-spacing);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-gap-xs);
  }
  .sub {
    color: var(--s-color-content-muted);
    font-family: var(--s-typo-body-small-family);
    font-weight: var(--s-typo-body-small-weight);
    font-size: var(--s-typo-body-small-size);
    line-height: var(--s-typo-body-small-line);
    letter-spacing: var(--s-typo-body-small-spacing);
  }
  .result[aria-disabled='true'] .sub {
    color: var(--s-color-content-disabled);
  }
  .result > :global(svg) {
    flex-shrink: 0;
  }
  /* Ponto de status (8px). Sempre acompanhado do texto do status ao lado (princípio 3). */
  .dot {
    box-sizing: border-box;
    flex-shrink: 0;
    width: var(--primitives-spacing-8);
    height: var(--primitives-spacing-8);
    border: var(--border-width-default) solid;
    border-radius: var(--radius-full);
  }
  .dot--suitable {
    background: var(--s-color-surface-positive-default);
    border-color: var(--s-color-border-positive);
  }
  .dot--unsuitable {
    background: var(--s-color-surface-negative-default);
    border-color: var(--s-color-border-negative);
  }
  .dot--outdated {
    background: var(--s-color-surface-warning-default);
    border-color: var(--s-color-border-warning);
  }
  /* Desconhecido (Figma 117:6459): círculo cheio #8EA9B3 (surface/unknown/default), sem borda
     visível; antes era surface clara com borda. */
  .dot--no-result {
    background: var(--s-color-surface-unknown-default);
    border-color: var(--s-color-surface-unknown-default);
  }

  /* Sem resultado de busca: mesmo desenho do erro do mapa, centrado no corpo. */
  .body:has(.empty:not([hidden])) {
    justify-content: center;
  }
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Inset vertical de 40px (token inset/2xl) em volta da mensagem. */
    padding-block: var(--space-inset-2xl);
    gap: var(--space-gap-xl);
  }
  .empty-icon {
    display: flex;
    padding: var(--space-inset-sm);
    background: var(--s-color-surface-accent-subtle);
    color: var(--s-color-content-accent);
  }
  .empty-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-lg);
    width: 230px;
  }
  .empty-texts {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-gap-md);
    text-align: center;
  }
  .empty-action :global(.btn) {
    width: 100%;
  }
  .empty-title,
  .empty-body {
    margin: 0;
  }
  .empty-title {
    color: var(--s-color-content-primary);
    font-family: var(--s-typo-heading-large-family);
    font-weight: var(--s-typo-heading-large-weight);
    font-size: var(--s-typo-heading-large-size);
    line-height: var(--s-typo-heading-large-line);
    letter-spacing: var(--s-typo-heading-large-spacing);
  }
  .empty-body {
    color: var(--s-color-content-secondary);
    font-family: var(--s-typo-body-medium-family);
    font-weight: var(--s-typo-body-medium-weight);
    font-size: var(--s-typo-body-medium-size);
    line-height: var(--s-typo-body-medium-line);
    letter-spacing: var(--s-typo-body-medium-spacing);
  }

  /* Mobile (abaixo de 1024px, folha inferior): padding 16 em todos os lados (Figma 117:5312 e
     117:5329); o corpo respeita a área segura de baixo (derivado, ver docs/decisions.md). */
  @media (max-width: 1023px) {
    .search {
      border-top: var(--border-width-default) solid
        var(--s-color-border-default);
    }
    .head {
      padding: var(--space-inset-md);
    }
    .body {
      padding: var(--space-inset-md);
      padding-bottom: calc(
        var(--space-inset-md) + env(safe-area-inset-bottom, 0px)
      );
    }
    .search {
      overscroll-behavior: contain;
    }
    /* Alvo de toque do fechar: 40px no desenho, 44px na área de toque. */
    .close :global(.btn-icon) {
      position: relative;
    }
    .close :global(.btn-icon)::after {
      content: '';
      position: absolute;
      inset: calc(var(--primitives-spacing-4) / -2);
    }
  }

  /* Esqueleto de carregamento (Figma de Caio): blocos na cor surface/strong no lugar do título,
     do chip, do campo e dos bairros, enquanto o mapa carrega (escolher uma praia depende dele).
     O botão de fechar fica. Estático: o brilho/pulso é motion e espera a fase de motion. */
  .sk,
  .sk-body {
    display: none;
  }
  .search[data-loading] .sk {
    display: block;
    background: var(--s-color-surface-strong);
  }
  .search[data-loading] .sk-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-md);
  }
  .search[data-loading] h2,
  .search[data-loading] .bulletin-chip,
  .search[data-loading] .field,
  .search[data-loading] .body > :not(.sk-body) {
    display: none;
  }
  .sk--title {
    width: calc(var(--primitives-spacing-48) * 3);
    height: var(--primitives-spacing-24);
  }
  .search[data-loading] .head-top::after {
    content: '';
    width: 55%;
    height: var(--primitives-spacing-24);
    background: var(--s-color-surface-strong);
  }
  .sk--field {
    height: calc(var(--space-inset-md) * 2 + var(--primitives-spacing-24));
  }
  .sk--label {
    width: 10%;
    height: var(--primitives-spacing-16);
  }
  .sk-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-gap-xs);
  }
  .sk--hood {
    height: var(--primitives-spacing-40);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import { queryTokens, searchBeaches } from '../lib/search/search.ts';

  const root = document.querySelector<HTMLElement>('.search');
  if (root) init(root);

  function init(root: HTMLElement) {
    const trigger = document.querySelector<HTMLElement>(
      `[aria-controls="${root.id}"]`,
    );
    const input = root.querySelector<HTMLInputElement>('input')!;
    const found = root.querySelector<HTMLElement>('[data-found]')!;
    const list = root.querySelector<HTMLElement>('[data-results]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const emptyQ = root.querySelector<HTMLElement>('[data-empty-q]')!;
    const hoods = root.querySelector<HTMLElement>('[data-hoods]');
    const countN = root.querySelector<HTMLElement>('[data-count-n]')!;
    const countRest = root.querySelector<HTMLElement>('[data-count-rest]')!;
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    const items = [...root.querySelectorAll<HTMLElement>('[data-result]')].map(
      (li) => ({
        li,
        slug: li.dataset.slug!,
        name: li.dataset.name!,
        neighborhood: li.dataset.hood || null,
      }),
    );

    function visibleButtons() {
      return items
        .filter((i) => !i.li.hidden)
        .map((i) => i.li.querySelector<HTMLButtonElement>('button')!);
    }

    // Os bairros ficam sempre visíveis (Figma 117:6342): só os resultados e o vazio mudam.
    // Esqueleto enquanto o mapa carrega (escolher uma praia depende dele). No erro do mapa o
    // painel volta ao normal. Acompanha o aviso "Carregando o mapa…" do próprio mapa.
    const mapLoading = document.getElementById('map-loading');
    function syncLoading() {
      const on = !!mapLoading && !mapLoading.hidden;
      root.toggleAttribute('data-loading', on);
      root.setAttribute('aria-busy', String(on));
    }
    if (mapLoading) {
      new MutationObserver(syncLoading).observe(mapLoading, {
        attributes: true,
        attributeFilter: ['hidden'],
      });
    }
    syncLoading();

    const back = root.querySelector<HTMLElement>('[data-search-back]')!;
    const field = root.querySelector<HTMLElement>('[data-field]')!;
    const title = root.querySelector<HTMLElement>('[data-title]')!;
    let hoodName = '';

    // Bairro "ligado" quando o campo traz exatamente o nome dele (Figma 117:5257, 2º quadro).
    const hoodButtons = [...root.querySelectorAll<HTMLElement>('.hood')].map(
      (el) => ({ el, button: el.querySelector<HTMLButtonElement>('button')! }),
    );
    function syncHoods() {
      const typed = input.value.trim().toLowerCase();
      hoodButtons.forEach(({ el, button }) => {
        const on = typed !== '' && el.dataset.hood!.toLowerCase() === typed;
        button.toggleAttribute('data-selected', on);
        button.setAttribute('aria-pressed', String(on));
      });
    }
    // Teclado virtual: no mobile, escolher um bairro não o abre (a lista fica toda visível).
    const mobile = window.matchMedia('(max-width: 1023px)');

    // Bairro escolhido pelo botão: a seção "Bairros" sai e ficam só as praias encontradas.
    let hoodPicked = false;

    // Vista de um bairro (concept): seta de voltar e nome do bairro no lugar de "Buscar", sem o
    // campo; só o chip do boletim, a contagem e a lista.
    function syncView() {
      back.hidden = !hoodPicked;
      field.hidden = hoodPicked;
      title.textContent = hoodPicked ? hoodName : 'Buscar';
    }

    function render() {
      syncView();
      syncHoods();
      const searching = queryTokens(input.value).length > 0;
      items.forEach((i) => (i.li.hidden = true));
      if (!searching) {
        found.hidden = true;
        empty.hidden = true;
        if (hoods) hoods.hidden = false;
        live.textContent = '';
        return;
      }
      const hits = searchBeaches(items, input.value);
      hits.forEach((i) => {
        i.li.hidden = false;
        list.append(i.li);
      });
      found.hidden = hits.length === 0;
      empty.hidden = hits.length > 0;
      emptyQ.textContent = input.value.trim();
      // Sem resultado: só o aviso (Figma); com resultados, os bairros ficam abaixo.
      if (hoods) hoods.hidden = hits.length === 0 || hoodPicked;
      const one = hits.length === 1;
      countN.textContent = `${hits.length} ${one ? 'praia' : 'praias'}`;
      countRest.textContent = ` ${one ? 'encontrada' : 'encontradas'}`;
      live.textContent =
        hits.length === 0
          ? 'Nenhuma praia encontrada'
          : `${hits.length} ${one ? 'praia encontrada' : 'praias encontradas'}`;
    }

    function setOpen(open: boolean) {
      root.hidden = !open;
      trigger?.setAttribute('aria-expanded', String(open));
    }

    function open() {
      input.value = '';
      hoodPicked = false;
      render();
      setOpen(true);
      document.dispatchEvent(new CustomEvent('search-open'));
      input.focus();
    }

    // Um marcador do mapa abriu a ficha: a busca sai (nunca dois painéis ao mesmo tempo).
    document.addEventListener('marker-select', () => setOpen(false));

    function close() {
      setOpen(false);
      document.dispatchEvent(new CustomEvent('search-close'));
      trigger?.focus();
    }

    function choose(button: HTMLElement | undefined) {
      if (!button || button.getAttribute('aria-disabled') === 'true') return;
      const slug = button.closest<HTMLElement>('[data-result]')?.dataset.slug;
      if (!slug) return;
      setOpen(false);
      document.dispatchEvent(
        new CustomEvent('search-select', { detail: { slug } }),
      );
    }

    trigger?.addEventListener('click', () => (root.hidden ? open() : close()));
    input.addEventListener('input', () => {
      hoodPicked = false;
      render();
    });

    root.addEventListener('click', (e) => {
      const target = e.target as Element;
      if (target.closest('[data-search-close]')) return close();
      if (target.closest('[data-search-retry]')) {
        input.value = '';
        hoodPicked = false;
        render();
        input.focus();
        return;
      }
      const hood = target.closest<HTMLElement>('.hood');
      if (hood) {
        input.value = hood.dataset.hood!;
        hoodName = hood.dataset.hood!;
        hoodPicked = true;
        render();
        // O campo sai da vista: o foco vai para a seta de voltar.
        back.querySelector<HTMLElement>('button')?.focus();
        return;
      }
      if (target.closest('[data-search-back]')) {
        // Volta à busca inicial (campo vazio, bairros), com o foco no bairro que estava aberto.
        const name = hoodName;
        input.value = '';
        hoodPicked = false;
        render();
        hoodButtons.find(({ el }) => el.dataset.hood === name)?.button.focus();
        return;
      }
      choose(target.closest<HTMLElement>('.result') ?? undefined);
    });

    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.stopPropagation();
        return close();
      }
      const buttons = visibleButtons();
      const at = buttons.indexOf(document.activeElement as HTMLButtonElement);
      if (e.key === 'ArrowDown' && buttons.length > 0) {
        e.preventDefault();
        buttons[Math.min(at + 1, buttons.length - 1)].focus();
      } else if (e.key === 'ArrowUp' && at >= 0) {
        e.preventDefault();
        (at === 0 ? input : buttons[at - 1]).focus();
      } else if (
        e.key === 'Enter' &&
        document.activeElement === input &&
        buttons.length > 0
      ) {
        e.preventDefault();
        choose(buttons[0]);
      }
    });
  }
</script>
