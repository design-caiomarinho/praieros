---
import '../styles/tokens.css';
import '../styles/fonts.css';

import tokens from '../../tokens/tokens.json';
import { resolveColor } from '../lib/seo/colors.ts';
import { publicUrl, seoTags, type SeoImage } from '../lib/seo/meta.ts';

interface Props {
  title: string;
  description: string;
  /** Miniatura do compartilhamento. Sem ela, vale a do site (public/og.jpg). */
  image?: SeoImage;
  /** Páginas só de compartilhamento ficam fora do índice do Google. */
  noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = Astro.site!.origin;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteImage: SeoImage = {
  url: publicUrl(origin, base, 'og.jpg'),
  alt: 'Logo do Praieros sobre o mapa de Salvador',
  width: 1200,
  height: 630,
  type: 'image/jpeg',
};
const tags = seoTags({
  title,
  description,
  canonical,
  image: image ?? siteImage,
  noindex,
});
// Cor da barra do navegador no celular: o fundo padrão do site, direto dos tokens.
const themeColor = resolveColor(tokens, 'color.surface.default');
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta name="theme-color" content={themeColor} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {tags.map((t) =>
      t.tag === 'link' ? (
        <link rel={t.rel} href={t.href} />
      ) : t.property ? (
        <meta property={t.property} content={t.content} />
      ) : (
        <meta name={t.name} content={t.content} />
      ),
    )}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  /* Sem "puxar para atualizar" nem efeito de rebote: os gestos de arrastar (folha, mapa) são do app. */
  html,
  body {
    overscroll-behavior: none;
  }
  body {
    margin: 0;
    background: var(--color-surface-default);
    color: var(--color-content-primary);
    font-family: var(--typo-body-medium-family);
    font-weight: var(--typo-body-medium-weight);
    font-size: var(--typo-body-medium-size);
    line-height: var(--typo-body-medium-line);
  }
  /* Barra de rolagem fina (4px) em todas as áreas roláveis (painéis, busca, ficha), não só no body. */
  * {
    --sb-track-color: var(--primitives-color-neutral-200);
    --sb-thumb-color: var(--primitives-color-neutral-300);
    --sb-size: var(--primitives-spacing-4);
  }
  *::-webkit-scrollbar {
    width: var(--sb-size);
    height: var(--sb-size);
  }
  *::-webkit-scrollbar-track {
    background: var(--sb-track-color);
  }
  *::-webkit-scrollbar-thumb {
    background: var(--sb-thumb-color);
  }
  @supports not selector(::-webkit-scrollbar) {
    * {
      scrollbar-width: thin;
      scrollbar-color: var(--sb-thumb-color) var(--sb-track-color);
    }
  }
</style>
