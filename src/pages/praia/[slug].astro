---
import BaseLayout from '../../layouts/base-layout.astro';
import { loadSite } from '../../lib/site/load-site.ts';
import { toMarkers } from '../../lib/site/map-markers.ts';
import {
  openBeachPath,
  shareImageUrl,
  sharePreview,
  shareUrl,
} from '../../lib/share/share.ts';

// Página de compartilhamento da praia (R6): leva a prévia (status + data do boletim de quando o
// site foi gerado) e abre o site na ficha, que sempre mostra o estado atual.
export async function getStaticPaths() {
  const { site } = await loadSite();
  // Só praias com marcador: são as únicas cuja ficha abre no site.
  const slugsOnMap = new Set(toMarkers(site.beaches).map((m) => m.slug));
  return site.beaches
    .filter((b) => slugsOnMap.has(b.slug))
    .map((beach) => ({
      params: { slug: beach.slug },
      props: { beach, current: site.current },
    }));
}

const { beach, current } = Astro.props;
const base = import.meta.env.BASE_URL;
const origin = Astro.site!.origin;
const { title, description } = sharePreview(beach, current);
const url = shareUrl(origin, base, beach.slug);
const image = shareImageUrl(origin, base, beach.slug);
const target = openBeachPath(base, beach.slug);
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Praieros" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`Mapa com o ponto da praia ${beach.name}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </Fragment>
  <p>
    Abrindo a ficha de {beach.name}…<a href={target}>Abrir no Praieros</a>
  </p>
</BaseLayout>
