---
import BaseLayout from '../../layouts/base-layout.astro';
import { loadSite } from '../../lib/site/load-site.ts';
import { toMarkers } from '../../lib/site/map-markers.ts';
import {
  openBeachPath,
  shareImageUrl,
  sharePreview,
} from '../../lib/share/share.ts';

// Página de compartilhamento da praia (R6): leva a prévia (status + data do boletim de quando o
// site foi gerado) e abre o site na ficha, que sempre mostra o estado atual.
export async function getStaticPaths() {
  const { site } = await loadSite();
  // Só praias com marcador: são as únicas cuja ficha abre no site.
  const slugsOnMap = new Set(toMarkers(site.beaches).map((m) => m.slug));
  return site.beaches
    .filter((b) => slugsOnMap.has(b.slug))
    .map((beach) => ({
      params: { slug: beach.slug },
      props: { beach, current: site.current },
    }));
}

const { beach, current } = Astro.props;
const base = import.meta.env.BASE_URL;
const origin = Astro.site!.origin;
const { title, description } = sharePreview(beach, current);
const image = shareImageUrl(origin, base, beach.slug);
const target = openBeachPath(base, beach.slug);
---

<BaseLayout
  title={title}
  description={description}
  noindex
  image={{
    url: image,
    alt: `Mapa com o ponto da praia ${beach.name}`,
    width: 1200,
    height: 630,
    type: 'image/jpeg',
  }}
>
  <!-- Redirecionamento por script: quem lê o link para a prévia (WhatsApp) não executa script e
       fica nesta página; um meta refresh poderia levá-lo à página inicial, sem as tags og. -->
  <script is:inline define:vars={{ target }}>
    location.replace(target);
  </script>
  <p>
    Abrindo a ficha de {beach.name}…<a href={target}>Abrir no Praieros</a>
  </p>
</BaseLayout>
