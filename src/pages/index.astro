---
import BaseLayout from '../layouts/base-layout.astro';
import AppHeader from '../components/app-header.astro';
import BeachMap from '../components/beach-map.astro';
import BeachPanel from '../components/beach-panel.astro';
import SearchPanel from '../components/search-panel.astro';
import ClassificationPanel from '../components/classification-panel.astro';
import SourcePanel from '../components/source-panel.astro';
import { classificationFor } from '../lib/site/classification.ts';
import { toSearchResults } from '../lib/search/search.ts';
import OutdatedBanner from '../components/outdated-banner.astro';
import NoResultBanner from '../components/no-result-banner.astro';
import { loadSalvadorInputs, NOT_BEACHES } from '../lib/site/load-data.ts';
import { buildSiteModel } from '../lib/site/build-beach-models.ts';
import { toMarkers } from '../lib/site/map-markers.ts';
import {
  bulletinNumber,
  formatDate,
  toPanelData,
} from '../lib/site/panel-props.ts';

// Pontos com verified: false só aparecem em desenvolvimento; em produção, nenhum.
const {
  bulletins,
  catalog,
  references,
  referenceExclude,
  aliases,
  neighborhoodNames,
} = await loadSalvadorInputs();
const site = buildSiteModel(bulletins, catalog, {
  includeUnverified: import.meta.env.DEV,
  excluded: NOT_BEACHES,
  references,
  referenceExclude,
  aliases,
  neighborhoodNames,
});

const markers = toMarkers(site.beaches);
const pdfUrls = new Map(
  bulletins.flatMap((b) =>
    b.sourceUrl ? [[bulletinNumber(b), b.sourceUrl] as const] : [],
  ),
);
// Uma ficha por praia que tem ao menos um marcador (as outras não têm como ser abertas ainda).
const slugsOnMap = new Set(markers.map((m) => m.slug));
const panels = site.beaches
  .filter((b) => slugsOnMap.has(b.slug))
  .flatMap((beach) => {
    const data = toPanelData(beach, site.current, pdfUrls);
    return data
      ? [{ slug: beach.slug, data, classification: classificationFor(beach) }]
      : [];
  });
const searchResults = toSearchResults(site.beaches, slugsOnMap);
const currentBulletin = site.current
  ? {
      number: bulletinNumber(site.current),
      date: formatDate(site.current.issuedAt),
    }
  : null;
const sourceBulletin = site.current
  ? {
      ...currentBulletin!,
      pdfUrl: pdfUrls.get(bulletinNumber(site.current)),
    }
  : null;
---

<BaseLayout
  title="Praieros · Balneabilidade das praias de Salvador"
  description="Boletim de balneabilidade do Inema para as praias de Salvador (BA), apresentado de forma clara. Site independente, sem vínculo com o Inema."
>
  <div class="app">
    <AppHeader searchId="search" />
    <div class="stage" id="stage">
      <BeachMap markers={markers} />
      <!-- Faixa de aviso da praia aberta (desktop): no topo do mapa, não no painel. -->
      {panels.map(
        ({ slug, data }) =>
          data.notice && (
            <div class="map-banner" data-banner={slug} hidden>
              {data.notice === 'outdated' ? (
                <OutdatedBanner />
              ) : (
                <NoResultBanner />
              )}
            </div>
          ),
      )}
      <!-- Ficha: escondida até um marcador ser escolhido. Desktop e mobile são o mesmo
           conteúdo; o CSS mostra só uma versão. -->
      <aside class="panel" id="panel" aria-label="Ficha da praia" hidden>
        {panels.map(({ slug, data, classification }) => (
          <div data-beach={slug} hidden>
            <div class="layout-desktop">
              <BeachPanel
                {...data}
                layout="desktop"
                showDetails={!!classification}
              />
            </div>
            <div class="layout-mobile">
              <BeachPanel {...data} layout="mobile" />
            </div>
            {classification && (
              <div class="layout-classification">
                <ClassificationPanel
                  content={classification}
                  pdfUrl={data.bulletin.pdfUrl}
                  beachName={data.name}
                />
              </div>
            )}
          </div>
        ))}
      </aside>
      <!-- Busca: ocupa o lugar da ficha enquanto está aberta. -->
      <div class="search-slot" id="search-slot">
        <SearchPanel
          id="search"
          results={searchResults}
          bulletin={currentBulletin}
        />
      </div>
      <!-- Fonte e como ler: só desktop; ocupa o lugar da ficha/busca enquanto está aberta. -->
      <div class="source-slot" id="source-slot" hidden>
        <SourcePanel bulletin={sourceBulletin} />
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const map = document.getElementById('beach-map')!;
  const panel = document.getElementById('panel')!;
  let lastSlug: string | null = null;
  // Marcador clicado por último: continua marcado no mapa depois de fechar a ficha.
  let marked = false;

  function setActivePoint(slug: string | null, pointId: string | null) {
    panel.querySelectorAll<HTMLElement>('[data-point-id]').forEach((card) => {
      const sameBeach =
        card.closest('[data-beach]')?.getAttribute('data-beach') === slug;
      const active =
        !!pointId &&
        sameBeach &&
        card.getAttribute('data-point-id') === pointId;
      // Com um pin escolhido, os outros cartões da praia ficam a 50% (só visual).
      card.toggleAttribute('data-dimmed', !!pointId && sameBeach && !active);
      // Cartão = botão que escolhe o pin: marca qual está escolhido (leitor de tela).
      card.setAttribute('aria-pressed', String(active));
    });
  }

  function syncBanner(slug: string | null) {
    document.querySelectorAll<HTMLElement>('[data-banner]').forEach((el) => {
      el.hidden = el.getAttribute('data-banner') !== slug;
    });
  }

  /** Mostra a ficha ou a Classificação da praia aberta (a vista fica em `data-view`). */
  function setView(view: 'beach' | 'classification') {
    panel.querySelectorAll<HTMLElement>('[data-beach]').forEach((el) => {
      if (view === 'beach') el.removeAttribute('data-view');
      else if (!el.hidden) el.setAttribute('data-view', view);
    });
  }

  function close() {
    setView('beach');
    panel.hidden = true;
    syncBanner(null);
    panel.querySelectorAll('[data-beach]').forEach((el) => {
      (el as HTMLElement).hidden = true;
    });
    // Fechar a ficha mantém o marcador clicado marcado no mapa (o usuário não perde a
    // referência). Devolve o foco a ele.
    if (lastSlug) {
      const visible = [
        ...document.querySelectorAll<HTMLElement>(
          `[data-beach-marker="${CSS.escape(lastSlug)}"]`,
        ),
      ].filter((m) => m.offsetParent !== null);
      (
        visible.find((m) => m.dataset.state?.endsWith(':true')) ?? visible[0]
      )?.focus();
    }
  }

  /** Tira a marca do mapa (a ficha já está fechada). */
  function clearMark() {
    marked = false;
    lastSlug = null;
    setActivePoint(null, null);
    map.dispatchEvent(
      new CustomEvent('marker-set', { detail: { slug: null, pointId: null } }),
    );
  }

  map.addEventListener('marker-select', (e) => {
    const { slug, pointId = null } = (
      e as CustomEvent<{ slug: string; pointId?: string | null }>
    ).detail;
    const sameBeach = !panel.hidden && lastSlug === slug;
    // Outra praia: volta para a ficha (a Classificação é de uma praia só).
    if (!sameBeach) {
      setView('beach');
      fromSearch = false; // a busca (search-select) liga de novo logo depois
      syncBack();
    }
    lastSlug = slug;
    marked = true;
    panel.querySelectorAll('[data-beach]').forEach((el) => {
      (el as HTMLElement).hidden = el.getAttribute('data-beach') !== slug;
    });
    panel.hidden = false;
    syncBanner(slug);
    setActivePoint(slug, pointId);
    map.dispatchEvent(
      new CustomEvent('marker-set', { detail: { slug, pointId } }),
    );
    // Foco na ficha só ao abrir (clicar em pin com a ficha aberta não tira o foco do pin).
    if (sameBeach) return;
    [
      ...panel.querySelectorAll<HTMLElement>(
        `[data-beach="${CSS.escape(slug)}"] section.panel`,
      ),
    ]
      .find((b) => b.offsetParent !== null)
      ?.focus();
  });
  map.addEventListener('map-clear', () => {
    // Clique no mapa vazio: primeiro fecha a ficha; com ela fechada, tira a marca.
    if (!document.getElementById('source-slot')!.hidden) return;
    if (!panel.hidden) close();
    else if (marked) clearMark();
  });

  // Busca: abre no lugar da ficha e a encerra de vez (a ficha não fica "viva" por baixo).
  // Fechar a busca sem escolher volta ao mapa, nunca a uma ficha anterior. O marcador
  // clicado continua marcado.
  document.addEventListener('search-open', () => {
    setView('beach');
    panel.hidden = true;
    panel.querySelectorAll('[data-beach]').forEach((el) => {
      (el as HTMLElement).hidden = true;
    });
    syncBanner(null);
  });
  // Ficha aberta pela busca mostra a seta de voltar; aberta pelo mapa, não.
  let fromSearch = false;
  function syncBack() {
    document
      .querySelectorAll<HTMLElement>('[data-panel-back]')
      .forEach((el) => (el.hidden = !fromSearch));
  }
  document.addEventListener('search-select', (e) => {
    const { slug } = (e as CustomEvent<{ slug: string }>).detail;
    // Mesmo caminho do clique no marcador: enquadra (abrindo o grupo) e abre a ficha.
    map.dispatchEvent(new CustomEvent('marker-focus', { detail: { slug } }));
    map.dispatchEvent(
      new CustomEvent('marker-select', {
        bubbles: true,
        detail: { slug, pointId: null },
      }),
    );
    fromSearch = true;
    syncBack();
  });

  // Os cartões dos pontos são só visualização: quem escolhe o ponto é o pin no mapa.
  function focusVisible(selector: string) {
    [...panel.querySelectorAll<HTMLElement>(selector)]
      .find((el) => el.offsetParent !== null)
      ?.focus();
  }
  panel.addEventListener('click', (e) => {
    const target = e.target as Element;
    const card = target.closest<HTMLElement>('[data-point-id]');
    if (target.closest('[data-panel-close]')) close();
    else if (target.closest('[data-panel-back]')) {
      // Volta à busca como estava (texto, bairro e lista); a ficha sai.
      document.dispatchEvent(new CustomEvent('search-back'));
    } else if (card && card.dataset.pointId) {
      // Cartão do ponto: escolhe o pin dele no mapa (mesmo caminho do clique no pin).
      const slug = card.closest<HTMLElement>('[data-beach]')?.dataset.beach;
      if (slug) {
        map.dispatchEvent(
          new CustomEvent('marker-select', {
            bubbles: true,
            detail: { slug, pointId: card.dataset.pointId },
          }),
        );
        // Sempre enquadra as localizações da praia ao escolher um ponto (pedido de Caio).
        map.dispatchEvent(
          new CustomEvent('map-fit', { detail: { slugs: [slug] } }),
        );
      }
    } else if (target.closest('[data-open-classification]')) {
      setView('classification');
      focusVisible('.layout-classification section');
    } else if (target.closest('[data-classification-back]')) {
      // Volta à ficha da mesma praia, com o foco no botão que abriu a Classificação.
      setView('beach');
      focusVisible('[data-open-classification] button');
    }
  });

  // Fonte e como ler (desktop): ocupa o lugar da ficha/busca; voltar devolve a ficha que estava
  // aberta, fechar encerra tudo. O foco volta a quem abriu.
  const sourceSlot = document.getElementById('source-slot')!;
  const desktop = window.matchMedia('(min-width: 1024px)');
  let sourceOpener: HTMLElement | null = null;
  let panelBeforeSource = false;

  function openSource(opener: HTMLElement) {
    // A busca sai (nunca dois painéis ao mesmo tempo).
    const search = document.getElementById('search');
    if (search && !search.hidden) {
      search.querySelector<HTMLElement>('[data-search-close] button')?.click();
    }
    if (sourceSlot.hidden) {
      sourceOpener = opener;
      panelBeforeSource = !panel.hidden;
      panel.hidden = true;
      syncBanner(null);
      sourceSlot.hidden = false;
    }
    sourceSlot.querySelector<HTMLElement>('section')?.focus();
  }

  function closeSource(backToBeach: boolean) {
    if (sourceSlot.hidden) return;
    sourceSlot.hidden = true;
    const hadBeach = panelBeforeSource && !!lastSlug;
    panelBeforeSource = false;
    if (backToBeach && hadBeach) {
      panel.hidden = false;
      syncBanner(lastSlug);
    } else if (hadBeach) {
      close(); // fechar: encerra a ficha também (foco no marcador)
      return;
    }
    const fallback = document.querySelector<HTMLElement>('a[href="#fonte"]');
    const target =
      sourceOpener && sourceOpener.offsetParent !== null
        ? sourceOpener
        : fallback;
    target?.focus();
  }

  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLElement>('a[href="#fonte"]');
    if (!link || !desktop.matches) return;
    e.preventDefault();
    openSource(link);
  });
  sourceSlot.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (target.closest('[data-source-back]')) closeSource(true);
    else if (target.closest('[data-source-close]')) closeSource(false);
  });
  // O cabeçalho acompanha: com a Fonte aberta, o botão de informação fica sem a linha de baixo.
  const header = document.querySelector('header');
  new MutationObserver(() =>
    header?.toggleAttribute('data-source-open', !sourceSlot.hidden),
  ).observe(sourceSlot, { attributes: true, attributeFilter: ['hidden'] });
  // Escolher um marcador ou abrir a busca tira a Fonte do lugar.
  map.addEventListener('marker-select', () => {
    sourceSlot.hidden = true;
    panelBeforeSource = false;
  });
  document.addEventListener('search-open', () => {
    sourceSlot.hidden = true;
    panelBeforeSource = false;
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!sourceSlot.hidden) return closeSource(true);
    if (!panel.hidden) close();
    else if (marked) clearMark();
  });
</script>

<style>
  .app {
    display: flex;
    flex-direction: column;
    height: 100dvh;
  }
  .stage {
    position: relative;
    display: flex;
    flex: 1;
    min-height: 0;
  }
  /* Mobile: folha inferior sobre o mapa, no mesmo padrão da busca (Figma 125:3460: 450px de
     756px de palco, ~60%); o conteúdo rola por dentro. */
  .panel {
    position: absolute;
    inset: auto 0 0;
    height: 60%;
    max-height: 100%;
    overflow-y: auto;
    background: var(--s-color-surface-default);
  }
  .layout-desktop {
    display: none;
  }
  /* Busca: o espaço só existe enquanto o painel está aberto. Mobile: folha inferior sobre o
     mapa (Figma 117:5257: 450px de 756px de palco, ~60%), que rola inteira por dentro. */
  .search-slot {
    display: contents;
  }
  .search-slot :global(.search) {
    position: absolute;
    inset: auto 0 0;
    height: 60%;
    z-index: 3;
  }
  /* Sem resultado: a folha se ajusta ao conteúdo (mensagem e botão sem rolar). */
  .search-slot :global(.search:has(.empty:not([hidden]))) {
    height: auto;
    max-height: 100%;
  }
  /* Faixa de aviso da praia aberta: no topo do mapa, no desktop e no mobile (Figma 125:3460). */
  .map-banner:not([hidden]) {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
  }
  /* Desktop: painel lateral à direita, com a largura do BeachPanel. */
  @media (min-width: 1024px) {
    .panel {
      position: static;
      flex-shrink: 0;
      width: var(--size-panel-width);
      height: auto;
      max-height: none;
    }
    /* Corpo da ficha ocupa a altura toda (links e crédito no rodapé); rola se for alta. */
    .panel:not([hidden]) {
      display: flex;
      flex-direction: column;
      overflow-y: auto;
    }
    .panel [data-beach]:not([hidden]) {
      display: flex;
      flex: 1 0 auto;
      flex-direction: column;
    }
    .search-slot :global(.search) {
      position: static;
      flex-shrink: 0;
      height: auto;
      z-index: auto;
    }
    .map-banner:not([hidden]) {
      right: var(--size-panel-width);
    }
    .layout-desktop {
      display: flex;
      flex: 1 0 auto;
      flex-direction: column;
    }
    .layout-desktop > :global(section) {
      flex: 1 0 auto;
    }
    .layout-mobile {
      display: none;
    }
    /* Classificação: só desktop; no lugar da ficha enquanto estiver aberta. */
    [data-view='classification'] .layout-desktop {
      display: none;
    }
    [data-view='classification'] .layout-classification {
      display: flex;
      flex: 1 0 auto;
      flex-direction: column;
    }
    .layout-classification > :global(section) {
      flex: 1 0 auto;
    }
  }
  .layout-classification {
    display: none;
  }
  /* Fonte e como ler: só desktop, à direita como a ficha. */
  .source-slot {
    display: none;
  }
  @media (min-width: 1024px) {
    .source-slot:not([hidden]) {
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      width: var(--size-panel-width);
      overflow-y: auto;
    }
    .source-slot :global(section) {
      flex: 1 0 auto;
    }
  }
</style>
