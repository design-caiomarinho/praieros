---
import BaseLayout from '../layouts/base-layout.astro';
import AppHeader from '../components/app-header.astro';
import BeachMap from '../components/beach-map.astro';
import BeachPanel from '../components/beach-panel.astro';
import SearchPanel from '../components/search-panel.astro';
import ClassificationPanel from '../components/classification-panel.astro';
import SourcePanel from '../components/source-panel.astro';
import { classificationFor } from '../lib/site/classification.ts';
import { toSearchResults } from '../lib/search/search.ts';
import OutdatedBanner from '../components/outdated-banner.astro';
import NoResultBanner from '../components/no-result-banner.astro';
import { loadSalvadorInputs, NOT_BEACHES } from '../lib/site/load-data.ts';
import { buildSiteModel } from '../lib/site/build-beach-models.ts';
import { toMarkers } from '../lib/site/map-markers.ts';
import {
  bulletinNumber,
  formatDate,
  toPanelData,
} from '../lib/site/panel-props.ts';

// Pontos com verified: false só aparecem em desenvolvimento; em produção, nenhum.
const {
  bulletins,
  catalog,
  references,
  referenceExclude,
  aliases,
  neighborhoodNames,
} = await loadSalvadorInputs();
const site = buildSiteModel(bulletins, catalog, {
  includeUnverified: import.meta.env.DEV,
  excluded: NOT_BEACHES,
  references,
  referenceExclude,
  aliases,
  neighborhoodNames,
});

const markers = toMarkers(site.beaches);
const pdfUrls = new Map(
  bulletins.flatMap((b) =>
    b.sourceUrl ? [[bulletinNumber(b), b.sourceUrl] as const] : [],
  ),
);
// Uma ficha por praia que tem ao menos um marcador (as outras não têm como ser abertas ainda).
const slugsOnMap = new Set(markers.map((m) => m.slug));
const panels = site.beaches
  .filter((b) => slugsOnMap.has(b.slug))
  .flatMap((beach) => {
    const data = toPanelData(beach, site.current, pdfUrls);
    return data
      ? [{ slug: beach.slug, data, classification: classificationFor(beach) }]
      : [];
  });
const searchResults = toSearchResults(site.beaches, slugsOnMap);
const currentBulletin = site.current
  ? {
      number: bulletinNumber(site.current),
      date: formatDate(site.current.issuedAt),
    }
  : null;
const sourceBulletin = site.current
  ? {
      ...currentBulletin!,
      pdfUrl: pdfUrls.get(bulletinNumber(site.current)),
    }
  : null;
---

<BaseLayout
  title="Praieros · Balneabilidade das praias de Salvador"
  description="Boletim de balneabilidade do Inema para as praias de Salvador (BA), apresentado de forma clara. Site independente, sem vínculo com o Inema."
>
  <div class="app">
    <AppHeader searchId="search" />
    <div class="stage" id="stage">
      <BeachMap markers={markers} />
      <!-- Faixa de aviso da praia aberta (desktop): no topo do mapa, não no painel. -->
      {panels.map(
        ({ slug, data }) =>
          data.notice && (
            <div class="map-banner" data-banner={slug} hidden>
              {data.notice === 'outdated' ? (
                <OutdatedBanner />
              ) : (
                <NoResultBanner />
              )}
            </div>
          ),
      )}
      <!-- Ficha: escondida até um marcador ser escolhido. Desktop e mobile são o mesmo
           conteúdo; o CSS mostra só uma versão. -->
      <!-- Sidebar (desktop): camada azul + painel que entram da direita por cima do mapa e
           hospedam a busca, a ficha, a Classificação e a Fonte (ver docs/motion.md). Trocar de
           conteúdo com ele aberto só dissolve; no mobile é transparente (display: contents). -->
      <div class="sidebar" id="sidebar">
        <div class="sidebar__viewport" id="sidebar-viewport">
          <aside class="panel" id="panel" aria-label="Ficha da praia" hidden>
            {panels.map(({ slug, data, classification }) => (
              <div data-beach={slug} hidden>
                <div class="layout-desktop">
                  <BeachPanel
                    {...data}
                    layout="desktop"
                    showDetails={!!classification}
                  />
                </div>
                <div class="layout-mobile">
                  <BeachPanel
                    {...data}
                    layout="mobile"
                    showDetails={!!classification}
                  />
                </div>
                {classification && (
                  <div class="layout-classification">
                    <ClassificationPanel
                      content={classification}
                      pdfUrl={data.bulletin.pdfUrl}
                      beachName={data.name}
                    />
                  </div>
                )}
              </div>
            ))}
          </aside>
          <!-- Busca: no mesmo sidebar da ficha. -->
          <div class="search-slot" id="search-slot">
            <SearchPanel
              id="search"
              results={searchResults}
              bulletin={currentBulletin}
            />
          </div>
          <!-- Fonte e como ler: só desktop; ocupa o lugar da ficha/busca enquanto está aberta. -->
          <div class="source-slot" id="source-slot" hidden>
            <SourcePanel bulletin={sourceBulletin} />
          </div>
          <div class="sidebar__ghosts" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { halfwayTime } from '../lib/map/cubic-bezier.ts';
  import { cssTimeMs } from '../lib/map/css-time.ts';
  import { initSidebarShell } from '../lib/site/sidebar-shell.ts';
  import { initSidebarSheet } from '../lib/site/sidebar-sheet.ts';
  import { resetScroll } from '../lib/site/scroll-area.ts';

  initSidebarShell();
  initSidebarSheet();
  const map = document.getElementById('beach-map')!;
  const panel = document.getElementById('panel')!;
  let lastSlug: string | null = null;
  // Marcador clicado por último: continua marcado no mapa depois de fechar a ficha.
  let marked = false;

  function setActivePoint(slug: string | null, pointId: string | null) {
    panel.querySelectorAll<HTMLElement>('[data-point-id]').forEach((card) => {
      const sameBeach =
        card.closest('[data-beach]')?.getAttribute('data-beach') === slug;
      const active =
        !!pointId &&
        sameBeach &&
        card.getAttribute('data-point-id') === pointId;
      // O cartão do pin escolhido ganha a borda da cor do status e deixa de responder (sem hover
      // nem clique); os outros seguem normais.
      card.toggleAttribute('data-current', active);
      // Cartão = botão que escolhe o pin: marca qual está escolhido (leitor de tela).
      card.setAttribute('aria-pressed', String(active));
    });
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const mobile = window.matchMedia('(max-width: 1023.98px)');
  /** Quando o painel chega a 50% do trajeto (a curva é rápida no começo e longa no fim): a faixa
   *  entra daí, sem esperar o painel terminar de chegar. */
  function panelHalfway(): number {
    const cs = getComputedStyle(document.documentElement);
    const n = (name: string) => cssTimeMs(cs.getPropertyValue(name));
    return (
      n('--motion-delay-panel') +
      halfwayTime(cs.getPropertyValue('--motion-easing-panel')) *
        n('--motion-duration-panel')
    );
  }
  /** Mostra a faixa da praia aberta. Ela desce de trás do cabeçalho (como o nome do pin) e, ao
   *  fechar sem outra faixa no lugar, sobe de volta; com outra faixa, a troca é direta. */
  function syncBanner(slug: string | null) {
    const banners = [
      ...document.querySelectorAll<HTMLElement>('[data-banner]'),
    ];
    const next = banners.find((el) => el.getAttribute('data-banner') === slug);
    banners.forEach((el) => {
      // A saída em andamento segue (syncBanner(null) é chamado várias vezes): só cancela o
      // fechamento pendente quando a faixa volta ou é trocada.
      if (el.hasAttribute('data-leaving') && !next && !reduceMotion.matches)
        return;
      window.clearTimeout(Number(el.dataset.timer) || undefined);
      el.removeAttribute('data-timer');
      if (el === next) {
        el.removeAttribute('data-leaving');
        if (el.hidden) {
          // Sidebar ainda fechado: a faixa espera o painel chegar (atraso + duração do painel).
          // No mobile a faixa (no topo) e o painel (embaixo) não se cruzam: entram juntos.
          const opening =
            !mobile.matches &&
            !document.getElementById('sidebar')?.hasAttribute('data-open');
          el.style.setProperty(
            '--banner-delay',
            `${opening ? panelHalfway() : 0}ms`,
          );
        }
        el.hidden = false;
        void el.offsetWidth; // fixa a largura de partida antes de o sidebar abrir (transição)
      } else if (el.hidden) {
        el.removeAttribute('data-leaving');
      } else if (next || reduceMotion.matches) {
        el.removeAttribute('data-leaving');
        el.hidden = true;
      } else if (!el.hasAttribute('data-leaving')) {
        el.setAttribute('data-leaving', '');
        const ms =
          cssTimeMs(
            getComputedStyle(el).getPropertyValue('--motion-duration-banner'),
          ) || 1000;
        el.dataset.timer = String(
          window.setTimeout(() => {
            el.hidden = true;
            el.removeAttribute('data-leaving');
          }, ms + 100),
        );
      }
    });
  }

  /** Mostra a ficha ou a Classificação da praia aberta (a vista fica em `data-view`). */
  function setView(view: 'beach' | 'classification') {
    panel.querySelectorAll<HTMLElement>('[data-beach]').forEach((el) => {
      if (view === 'beach') el.removeAttribute('data-view');
      else if (!el.hidden) el.setAttribute('data-view', view);
    });
    // A folha começa do topo a cada vista (a rolagem da ficha não vaza para a Classificação).
    resetScroll(panel);
  }

  function close() {
    setView('beach');
    panel.hidden = true;
    syncBanner(null);
    panel.querySelectorAll('[data-beach]').forEach((el) => {
      (el as HTMLElement).hidden = true;
    });
    // Fechar a ficha mantém o marcador clicado marcado no mapa (o usuário não perde a
    // referência). Devolve o foco a ele.
    if (lastSlug) {
      const visible = [
        ...document.querySelectorAll<HTMLElement>(
          `[data-beach-marker="${CSS.escape(lastSlug)}"]`,
        ),
      ].filter((m) => m.offsetParent !== null);
      (
        visible.find((m) => m.dataset.state?.endsWith(':true')) ?? visible[0]
      )?.focus();
    }
  }

  /** Tira a marca do mapa (a ficha já está fechada). */
  function clearMark() {
    marked = false;
    lastSlug = null;
    setActivePoint(null, null);
    map.dispatchEvent(
      new CustomEvent('marker-set', { detail: { slug: null, pointId: null } }),
    );
  }

  map.addEventListener('marker-select', (e) => {
    const { slug, pointId = null } = (
      e as CustomEvent<{ slug: string; pointId?: string | null }>
    ).detail;
    const sameBeach = !panel.hidden && lastSlug === slug;
    // Outra praia: volta para a ficha (a Classificação é de uma praia só).
    if (!sameBeach) {
      setView('beach');
      fromSearch = false; // a busca (search-select) liga de novo logo depois
      syncBack();
    }
    lastSlug = slug;
    marked = true;
    panel.querySelectorAll('[data-beach]').forEach((el) => {
      (el as HTMLElement).hidden = el.getAttribute('data-beach') !== slug;
    });
    panel.hidden = false;
    syncBanner(slug);
    setActivePoint(slug, pointId);
    map.dispatchEvent(
      new CustomEvent('marker-set', { detail: { slug, pointId } }),
    );
    // Foco na ficha só ao abrir (clicar em pin com a ficha aberta não tira o foco do pin).
    if (sameBeach) return;
    [
      ...panel.querySelectorAll<HTMLElement>(
        `[data-beach="${CSS.escape(slug)}"] section.panel`,
      ),
    ]
      .find((b) => b.offsetParent !== null)
      ?.focus();
  });
  map.addEventListener('map-clear', () => {
    // Clique no mapa vazio: fecha o painel aberto (ficha, Classificação ou Fonte) e tira a
    // marca do pin, de uma vez (pedido de Caio).
    const source = document.getElementById('source-slot')!;
    document.dispatchEvent(new CustomEvent('search-outside'));
    if (!source.hidden) {
      source.hidden = true;
      panelBeforeSource = false;
    }
    if (!panel.hidden) close();
    if (marked || lastSlug) clearMark();
  });

  // Busca: abre no lugar da ficha e a encerra de vez (a ficha não fica "viva" por baixo).
  // Fechar a busca sem escolher volta ao mapa, nunca a uma ficha anterior. O marcador
  // clicado continua marcado.
  document.addEventListener('search-open', () => {
    setView('beach');
    panel.hidden = true;
    panel.querySelectorAll('[data-beach]').forEach((el) => {
      (el as HTMLElement).hidden = true;
    });
    syncBanner(null);
  });
  // Ficha aberta pela busca mostra a seta de voltar; aberta pelo mapa, não.
  let fromSearch = false;
  function syncBack() {
    document
      .querySelectorAll<HTMLElement>('[data-panel-back]')
      .forEach((el) => (el.hidden = !fromSearch));
  }
  document.addEventListener('search-select', (e) => {
    const { slug } = (e as CustomEvent<{ slug: string }>).detail;
    // Mesmo caminho do clique no marcador: abre a ficha e enquadra (abrindo o grupo). A ficha
    // abre antes para a câmera já contar com a área que o sidebar cobre.
    map.dispatchEvent(
      new CustomEvent('marker-select', {
        bubbles: true,
        detail: { slug, pointId: null },
      }),
    );
    map.dispatchEvent(new CustomEvent('marker-focus', { detail: { slug } }));
    fromSearch = true;
    syncBack();
  });

  // Os cartões dos pontos são só visualização: quem escolhe o ponto é o pin no mapa.
  function focusVisible(selector: string) {
    [...panel.querySelectorAll<HTMLElement>(selector)]
      .find((el) => el.offsetParent !== null)
      ?.focus();
  }
  panel.addEventListener('click', (e) => {
    const target = e.target as Element;
    const card = target.closest<HTMLElement>('[data-point-id]');
    // O cartão do ponto já escolhido não faz nada.
    if (card?.hasAttribute('data-current')) return;
    if (target.closest('[data-panel-close]')) {
      // Fechar a Classificação (depois de ver os detalhes) encerra tudo: o pin volta ao normal.
      const fromDetails =
        panel
          .querySelector('[data-beach]:not([hidden])')
          ?.getAttribute('data-view') === 'classification';
      close();
      if (fromDetails && marked) clearMark();
    } else if (target.closest('[data-panel-back]')) {
      // Volta à busca como estava (texto, bairro e lista); a ficha sai.
      document.dispatchEvent(new CustomEvent('search-back'));
    } else if (card && card.dataset.pointId) {
      // Cartão do ponto: escolhe o pin dele no mapa (mesmo caminho do clique no pin).
      const slug = card.closest<HTMLElement>('[data-beach]')?.dataset.beach;
      if (slug) {
        map.dispatchEvent(
          new CustomEvent('marker-select', {
            bubbles: true,
            detail: { slug, pointId: card.dataset.pointId },
          }),
        );
        // Sempre enquadra as localizações da praia ao escolher um ponto (pedido de Caio).
        map.dispatchEvent(
          new CustomEvent('map-fit', { detail: { slugs: [slug] } }),
        );
      }
    } else if (target.closest('[data-open-classification]')) {
      setView('classification');
      focusVisible('.layout-classification section');
    } else if (target.closest('[data-classification-back]')) {
      // Volta à ficha da mesma praia, com o foco no botão que abriu a Classificação.
      setView('beach');
      focusVisible('[data-open-classification] button');
    }
  });

  // Fonte e como ler (desktop): ocupa o lugar da ficha/busca; voltar devolve a ficha que estava
  // aberta, fechar encerra tudo. O foco volta a quem abriu.
  const sourceSlot = document.getElementById('source-slot')!;
  let sourceOpener: HTMLElement | null = null;
  let panelBeforeSource = false;

  function openSource(opener: HTMLElement) {
    // A busca sai (nunca dois painéis ao mesmo tempo).
    const search = document.getElementById('search');
    if (search && !search.hidden) {
      document.dispatchEvent(new CustomEvent('search-dismiss'));
    }
    if (sourceSlot.hidden) {
      sourceOpener = opener;
      panelBeforeSource = !panel.hidden;
      panel.hidden = true;
      syncBanner(null);
      sourceSlot.hidden = false;
    }
    sourceSlot.querySelector<HTMLElement>('section')?.focus();
  }

  function closeSource(backToBeach: boolean) {
    if (sourceSlot.hidden) return;
    sourceSlot.hidden = true;
    const hadBeach = panelBeforeSource && !!lastSlug;
    panelBeforeSource = false;
    if (backToBeach && hadBeach) {
      panel.hidden = false;
      syncBanner(lastSlug);
    } else if (hadBeach) {
      close(); // fechar: encerra a ficha também (foco no marcador)
      return;
    }
    const fallback = document.querySelector<HTMLElement>('a[href="#fonte"]');
    const target =
      sourceOpener && sourceOpener.offsetParent !== null
        ? sourceOpener
        : fallback;
    target?.focus();
  }

  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLElement>('a[href="#fonte"]');
    if (!link) return;
    e.preventDefault();
    openSource(link);
  });
  sourceSlot.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (target.closest('[data-source-back]')) closeSource(true);
    else if (target.closest('[data-source-close]')) closeSource(false);
  });
  // O cabeçalho acompanha: com a Fonte aberta, o botão de informação fica sem a linha de baixo.
  const header = document.querySelector('header');
  new MutationObserver(() =>
    header?.toggleAttribute('data-source-open', !sourceSlot.hidden),
  ).observe(sourceSlot, { attributes: true, attributeFilter: ['hidden'] });
  // Escolher um marcador ou abrir a busca tira a Fonte do lugar.
  map.addEventListener('marker-select', () => {
    sourceSlot.hidden = true;
    panelBeforeSource = false;
  });
  document.addEventListener('search-open', () => {
    sourceSlot.hidden = true;
    panelBeforeSource = false;
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!sourceSlot.hidden) return closeSource(true);
    if (!panel.hidden) close();
    else if (marked) clearMark();
  });
</script>

<style>
  .app {
    display: flex;
    flex-direction: column;
    height: 100dvh;
  }
  .stage {
    position: relative;
    display: flex;
    flex: 1;
    min-height: 0;
  }
  /* Mobile: folha inferior sobre o mapa (Figma 125:3460 e 117:5257: 450px de 756px de palco,
     ~60%); o conteúdo rola por dentro. A folha é o mesmo sidebar do desktop, na vertical: a
     camada azul e o painel branco sobem de baixo, com os mesmos tempos e curva (pedido de Caio). */
  /* O painel não rola: o cabeçalho de cada vista fica fixo e só a área `[data-scroll]` rola, então a
     barra de rolagem começa abaixo do cabeçalho. */
  .panel {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--s-color-surface-default);
  }
  .panel:not([hidden]) {
    display: flex;
    flex-direction: column;
  }
  .panel [data-beach]:not([hidden]) {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
  }
  .layout-mobile {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
  }
  .layout-mobile > :global(section),
  .layout-classification > :global(section),
  .layout-desktop > :global(section) {
    flex: 1 1 auto;
    min-height: 0;
  }
  .layout-desktop {
    display: none;
  }
  /* A alça só existe no mobile (folha inferior). */
  .sidebar__viewport :global(.sidebar__handle) {
    display: none;
  }
  /* Busca: o espaço só existe enquanto o painel está aberto. */
  .search-slot {
    display: contents;
  }
  .search-slot :global(.search) {
    position: absolute;
    inset: 0;
    height: auto;
  }
  @media (max-width: 1023.98px) {
    .sidebar {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 100%;
      z-index: 3;
      /* Sem recorte: a alça flutua acima da borda da folha (o palco recorta o resto). */
      overflow: visible;
      pointer-events: none;
      /* A folha tem sempre a altura do palco e a origem (60% visível) é um deslocamento: subir e
         descer anima só transform (composição, sem recalcular layout a cada quadro, o que travava
         no celular). A parte de baixo fica fora do palco (recortada por .stage). */
      transform: translateY(40%);
      will-change: transform;
      transition: transform var(--motion-duration-sheet-drag)
        var(--motion-easing-panel);
    }
    /* Folha inteira (Figma 213:3802): sobra um vão de 20px do mapa no topo, para dar a sensação de
       algo ao fundo. Continua só transform; o rodapé que sai do palco ganha padding no conteúdo. */
    .sidebar[data-expanded] {
      transform: translateY(var(--primitives-spacing-20));
    }
    .sidebar[data-expanded]
      .sidebar__viewport
      :global(:is(#panel, #search, #source-slot)) {
      padding-bottom: var(--primitives-spacing-20);
    }
    /* Sem rolagem interna na posição de origem nem enquanto a folha se move: o conteúdo só rola com a
       folha na tela toda e já fixada (data-expanded sem data-moving, sidebar-sheet.ts). */
    .sidebar:not([data-expanded]) .sidebar__viewport :global([data-scroll]),
    .sidebar[data-moving] .sidebar__viewport :global([data-scroll]) {
      overflow-y: hidden;
    }
    /* Áreas de gesto: o navegador não pode tratar o arrastar como rolagem da página nem como
       "puxar para atualizar". Na origem a folha inteira é área de gesto (o conteúdo não rola); com a
       folha inteira, só a alça (a zona do título é tratada em sidebar-sheet.ts) e a rolagem do
       conteúdo não passa para a página. */
    .sidebar:not([data-expanded]) .sidebar__viewport,
    .sidebar:not([data-expanded]) .sidebar__viewport :global(*) {
      touch-action: none;
    }
    .sidebar__viewport :global([data-scroll]) {
      overscroll-behavior: contain;
    }
    .sidebar[data-moving] .sidebar__viewport,
    .sidebar[data-moving] .sidebar__viewport :global(*) {
      touch-action: none;
    }
    /* Alça (drag handle, Figma 213:3802): barra de 64×5 px (surface/inverse a 30%) que flutua 13 px
       acima da borda da folha, sobre o mapa. A faixa de toque é transparente: 24 px acima da borda
       e 16 px dentro (até o padding do cabeçalho). Sem token para 64, 5 e 13. */
    .sidebar__viewport :global(.sidebar__handle) {
      position: absolute;
      z-index: 4;
      top: calc(var(--space-inset-lg) * -1);
      left: 0;
      right: 0;
      touch-action: none;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      height: calc(var(--space-inset-lg) + var(--space-inset-md));
      padding: 0;
      border: 0;
      background: transparent;
      cursor: pointer;
    }
    .sidebar__viewport :global(.sidebar__handle span) {
      /* 13 px acima da borda = 24 - 13 = 11 px do topo da faixa. */
      margin-top: calc(var(--space-inset-lg) - 13px);
      width: calc(var(--primitives-spacing-32) * 2);
      height: 5px;
      border-radius: var(--radius-full);
      background: var(--s-color-surface-inverse);
      opacity: 0.3;
    }
    .sidebar__viewport :global(.sidebar__handle:focus-visible) {
      outline: var(--border-width-default) solid var(--s-color-border-focus);
      outline-offset: calc(var(--border-width-default) * -1);
    }
    .sidebar[data-active] {
      display: block;
    }
    .stage {
      overflow: clip;
    }
