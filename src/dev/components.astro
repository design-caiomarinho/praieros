---
import '../styles/tokens.css';
import '../styles/fonts.css';
import StatusChip from '../components/status-chip.astro';
import OutdatedBanner from '../components/outdated-banner.astro';
import NoResultBanner from '../components/no-result-banner.astro';
import PointCard from '../components/point-card.astro';
import Button from '../components/button.astro';
import ButtonIcon from '../components/button-icon.astro';
import InputText from '../components/input-text.astro';
import Icon from '../components/icon.astro';
import AppHeader from '../components/app-header.astro';
import BeachPanel from '../components/beach-panel.astro';
import type { ChipStatus } from '../lib/rules/status.ts';

// Dados fictícios, só para a vitrine. Cobrem as linhas da tabela de estados do CLAUDE.md.
const fakeBulletin = {
  number: '99/2026',
  date: '01/01/2026',
  pdfUrl: 'https://example.com/boletim.pdf',
};
const fakePoints = [
  {
    name: 'Ponto 1',
    location: 'Em frente ao posto de exemplo',
    status: 'suitable' as const,
  },
  {
    name: 'Ponto 2',
    location: 'Próximo à rua de exemplo',
    status: 'suitable' as const,
  },
  {
    name: 'Ponto 3',
    location: 'Final da orla de exemplo',
    status: 'unsuitable' as const,
  },
];
const panelStates = [
  {
    name: 'própria',
    props: {
      name: 'Praia Exemplo Um',
      neighborhood: 'Bairro Exemplo',
      points: [fakePoints[0]],
    },
  },
  {
    name: 'imprópria (1 de 3 pontos)',
    props: {
      name: 'Praia Exemplo Dois',
      neighborhood: 'Bairro Exemplo',
      points: fakePoints,
    },
  },
  {
    name: 'desatualizada (com a faixa)',
    props: {
      name: 'Praia Exemplo Três',
      neighborhood: 'Bairro Exemplo',
      points: [{ ...fakePoints[2], status: 'unsuitable' as const }],
      notice: 'outdated' as const,
    },
  },
  {
    name: 'sem resultado: nunca apareceu',
    props: {
      name: 'Praia Exemplo Quatro',
      neighborhood: 'Bairro Exemplo',
      points: [],
      notice: 'no-result' as const,
      note: 'Esta praia não consta no boletim nº 99/2026.',
    },
  },
  {
    name: 'sem resultado: antiga demais',
    props: {
      name: 'Praia Exemplo Cinco',
      neighborhood: 'Bairro Exemplo',
      points: [],
      notice: 'no-result' as const,
      note: 'A última análise foi em 01/06/2025, antiga demais para mostrar.',
    },
  },
];

const buttonVariants = ['primary', 'secondary', 'ghost'] as const;
const buttonSizes = ['medium', 'small'] as const;
const iconVariants = ['filled', 'outlined', 'ghost'] as const;
const iconSizes = ['medium', 'xsmall'] as const;
// "Ligado" só existe no Figma para secundário e ghost.
const buttonStates = [
  { name: 'padrão', props: {} },
  { name: 'hover', props: { state: 'hover' as const } },
  { name: 'foco', props: { state: 'focus' as const } },
  { name: 'desabilitado', props: { disabled: true } },
];
const inputStates = [
  { name: 'padrão', props: {} },
  { name: 'hover', props: { state: 'hover' as const } },
  { name: 'foco', props: { state: 'focus' as const } },
  { name: 'digitando', props: { state: 'typing' as const, value: 'Praia' } },
  { name: 'preenchido', props: { value: 'Praia' } },
  { name: 'desabilitado', props: { disabled: true, value: 'Praia' } },
  { name: 'sem ícone', props: { showIcon: false } },
];

const statuses: ChipStatus[] = [
  'suitable',
  'unsuitable',
  'outdated',
  'no-result',
];
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Componentes (dev)</title>
  </head>
  <body>
    <main>
      <h1>Componentes</h1>
      <section>
        <h2>StatusChip</h2>
        <ul>
          {statuses.map((status) => (
            <li>
              <StatusChip status={status} />
              <code>{status}</code>
            </li>
          ))}
        </ul>
      </section>
      <section>
        <h2>OutdatedBanner</h2>
        <OutdatedBanner />
      </section>
      <section>
        <h2>NoResultBanner</h2>
        <NoResultBanner />
      </section>
      <section>
        <h2>PointCard</h2>
        <div class="cards">
          {statuses.map((status) => (
            <PointCard
              name="Ponto 1"
              location="Av. Sete de Setembro, em frente à Rua Marquês de Leão, junto à escada de acesso à praia."
              status={status}
            />
          ))}
          <PointCard
            name="Ponto de coleta com um nome bem longo para testar a quebra de linha"
            status="suitable"
          />
        </div>
      </section>
      <section>
        <h2>Icon</h2>
        <div class="row">
          <Icon name="search" size={20} /> <code>search 20</code>
          <Icon name="search" size={24} /> <code>search 24</code>
          <Icon name="info" size={24} /> <code>info 24</code>
        </div>
      </section>
      <section>
        <h2>Button</h2>
        {buttonVariants.map((variant) =>
          buttonSizes.map((size) => (
            <div class="group">
              <h3>
                {variant} · {size}
              </h3>
              <div class="row">
                {buttonStates.map((s) => (
                  <Button
                    variant={variant}
                    size={size}
                    iconLeft="search"
                    {...s.props}
                  >
                    {s.name}
                  </Button>
                ))}
                {variant !== 'primary' && (
                  <Button
                    variant={variant}
                    size={size}
                    iconLeft="search"
                    selected
                  >
                    ligado
                  </Button>
                )}
                <Button variant={variant} size={size} iconRight="search">
                  ícone à direita
                </Button>
                <Button variant={variant} size={size}>
                  sem ícone
                </Button>
                <Button variant={variant} size={size} href="#">
                  link
                </Button>
              </div>
            </div>
          )),
        )}
      </section>
      <section>
        <h2>ButtonIcon</h2>
        {iconVariants.map((variant) =>
          iconSizes.map((size) => (
            <div class="group">
              <h3>
                {variant} · {size}
              </h3>
              <div class="row">
                {buttonStates.map((s) => (
                  <ButtonIcon
                    label={`Sobre (${s.name})`}
                    variant={variant}
                    size={size}
                    {...s.props}
                  />
                ))}
              </div>
            </div>
          )),
        )}
      </section>
      <section>
        <h2>InputText</h2>
        <div class="fields">
          {inputStates.map((s) => (
            <div>
              <code>{s.name}</code>
              <InputText label="Buscar praia" {...s.props} />
            </div>
          ))}
        </div>
      </section>
      <section>
        <h2>AppHeader</h2>
        <div class="frame frame--desktop">
          <AppHeader />
        </div>
        <div class="frame frame--mobile">
          <AppHeader />
        </div>
      </section>
      <section>
        <h2>BeachPanel</h2>
        {panelStates.map((s) => (
          <div class="group">
            <code>{s.name}</code>
            <div class="pair">
              <div class="frame frame--desktop">
                <BeachPanel
                  {...s.props}
                  bulletin={fakeBulletin}
                  layout="desktop"
                />
              </div>
              <div class="frame frame--mobile">
                <BeachPanel
                  {...s.props}
                  bulletin={fakeBulletin}
                  layout="mobile"
                />
              </div>
            </div>
          </div>
        ))}
      </section>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    background: var(--s-color-surface-default);
    color: var(--s-color-content-primary);
    font-family: var(--s-typo-body-medium-family);
    font-size: var(--s-typo-body-medium-size);
  }
  main {
    padding: var(--space-inset-lg);
  }
  h1 {
    font-size: var(--s-typo-heading-large-size);
    font-weight: var(--s-typo-heading-large-weight);
  }
  h2 {
    font-size: var(--s-typo-heading-medium-size);
    font-weight: var(--s-typo-heading-medium-weight);
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-sm);
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    align-items: center;
    gap: var(--space-gap-md);
  }
  .cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-md);
    max-width: 428px;
  }
  code {
    color: var(--s-color-content-muted);
  }
  h3 {
    margin: 0;
    font-size: var(--s-typo-body-medium-size);
    font-weight: var(--s-typo-label-medium-weight);
  }
  .group {
    display: flex;
    flex-direction: column;
    gap: var(--space-gap-md);
    padding-block: var(--space-inset-md);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-gap-lg);
    padding: var(--space-inset-xs);
  }
  .pair {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-gap-lg);
  }
  .frame {
    border: var(--border-width-default) dashed var(--s-color-border-default);
  }
  .frame--desktop {
    width: var(--size-panel-width);
    max-width: 100%;
  }
  .frame--mobile {
    width: 375px;
    max-width: 100%;
  }
  .fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-gap-lg);
    max-width: 428px;
    padding: var(--space-inset-xs);
  }
</style>
